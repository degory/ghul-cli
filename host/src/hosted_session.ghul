namespace Ghul.Repl.Host is
    use Ghul.Repl.CELL_EXPORTS
    use Ghul.Repl.CELL_REPLY
    use Ghul.Repl.CELL_ENTRY
    use Ghul.Repl.LOADED_CELL
    use Ghul.Repl.RUN_RESULT
    use Ghul.Repl.SESSION
    use System.Reflection.Assembly

    // What a submission did, for a front end to report.
    class SUBMIT_RESULT(
        is_accepted: bool,
        diagnostics: Collections.List[string],
        value: object?,
        run_error: string?
    );

    // The cells' own load context. The tool is itself a ghūl program, so
    // its process already holds a ghūl runtime - the one it was built
    // against, which is not the one the installed compiler builds cells
    // against, and two versions cannot both be the default. A context of
    // the session's own resolves the cells' runtime beside the cells and
    // leaves the tool's alone. One context for the session rather than
    // one per cell: a later cell references the earlier ones.
    class SESSION_LOAD_CONTEXT: System.Runtime.Loader.AssemblyLoadContext is
        _probe_directory: string?

        init(probe_directory: string?) is
            super.init("ghul-repl", false)

            _probe_directory = probe_directory
        si

        load(name: System.Reflection.AssemblyName) -> Assembly? is
            let directory = _probe_directory

            if !directory? then
                return null
            fi

            if let simple_name = name.name then
                let candidate = IO.Path.join([directory, "{simple_name}.dll"])

                if IO.File.exists(candidate) then
                    return load_from_assembly_path(candidate)
                fi
            fi

            return null
        si
    si

    // A session hosted in this process: each submission compiled through
    // the backend, loaded from where it was written, handed to the
    // session, and run once it has been accepted. It writes nothing to the
    // console itself; what a cell writes goes wherever the console points
    // while it runs.
    class HOSTED_SESSION(_backend: CompileBackend, _probe_directory: string?, _want_default_use: bool) is
        _session: SESSION
        _context: SESSION_LOAD_CONTEXT

        init(..) is
            _session = SESSION(_want_default_use)
            _context = SESSION_LOAD_CONTEXT(_probe_directory)
        si

        submit(source: string) -> SUBMIT_RESULT is
            let request = _session.prepare(source)
            let compiled = _backend.compile(request)

            let loaded: LOADED_CELL? mut = null

            if let assembly_path = compiled.assembly_path then
                loaded = CELL_EXPORTS.read(
                    _context.load_from_assembly_path(IO.Path.get_full_path(assembly_path)))
            fi

            let outcome = _session.accept(request, CELL_REPLY(compiled.diagnostics, loaded))

            if !outcome.is_accepted \/ !loaded? then
                return SUBMIT_RESULT(false, outcome.diagnostics, null, null)
            fi

            let run = CELL_ENTRY.run(loaded)

            return SUBMIT_RESULT(true, outcome.diagnostics, run.value, run.error)
        si

        // Ends the session's compiler, if it keeps one running.
        close() is
            _backend.close()
        si
    si

    // Starting a session in one call: a directory of its own, a compile
    // server started straight away so that it warms up before the first
    // cell, and starting the compiler for each cell if the server fails.
    // What the host is told about that goes to `say`.
    class HOST_SESSIONS is
        start(
            compiler_shim: string,
            runtime_assembly: string?,
            want_server: bool,
            want_default_use: bool,
            say: (string) -> void
        ) -> HOSTED_SESSION static is
            let directory = new_session_directory()
            let files = SESSION_FILES(directory, runtime_assembly)
            let spawn = SPAWN_BACKEND(compiler_shim, files)

            let backend: CompileBackend =
                if want_server then
                    SERVER_BACKEND(_start_server(compiler_shim, files), spawn, files, say)
                else
                    spawn
                fi

            return HOSTED_SESSION(backend, directory, want_default_use)
        si

        // A fresh directory under the temporary directory, for one
        // session's cells, or for anything else a host wants kept apart
        // from them.
        new_session_directory() -> string static =>
            IO.Path.join([IO.Path.get_temp_path(), "{REPL_SESSION_PREFIX}{System.Guid.new_guid().to_string("N")}"])

        // Null when it cannot be started at all, which the backend
        // reports once and then compiles without it.
        _start_server(compiler_shim: string, files: SESSION_FILES) -> ServerConnection? static is
            try
                files.prepare()

                return SERVER_PROCESS(compiler_shim, files.directory)
            catch e: System.Exception
                return null
            yrt
        si
    si
si
