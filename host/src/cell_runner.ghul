namespace Ghul.Repl.Host is
    use Ghul.Repl.RUN_RESULT

    use System.Threading.ManualResetEventSlim
    use System.Threading.Thread
    use System.Threading.WaitHandle

    // How a cell's run ended: with the value it ended on or the error it
    // raised, or interrupted, when nothing it produced is kept.
    class CELL_RUN(value: object?, error: string?, was_interrupted: bool);

    // Runs one cell at a time on a thread of its own, so that the thread
    // asking can stop waiting for it. .NET cannot stop a thread from
    // outside, so an interrupted cell is abandoned rather than ended: it
    // runs on in the background until it finishes or the process does,
    // and whatever it produces then is thrown away. Its thread is a
    // background one, so it never keeps the process alive.
    //
    // A cell is compiled before it runs, and an interrupt can arrive
    // while it compiles. `begin_cell` opens the window an interrupt is
    // kept for, so one arriving before `run` stops the cell before it
    // starts, and `end_cell` closes it.
    class CELL_RUNNER is
        // Set from begin_cell, or from run for a cell run on its own,
        // until the cell ends; interrupting sets it.
        _interrupt: ManualResetEventSlim?

        // Deeply recursive cells need more than a thread's default stack.
        STACK_SIZE: int static => 64 * 1024 * 1024

        init() is si

        // Whether a cell is in progress now, being compiled or running.
        is_running: bool => _interrupt?

        // A cell is in progress from here until end_cell: an interrupt in
        // between is kept, and the cell's run reports it.
        begin_cell() is
            _interrupt = ManualResetEventSlim(false)
        si

        end_cell() is
            _interrupt = null
        si

        // Runs `body` to the end, or until `interrupt` is called from any
        // thread. Within begin_cell and end_cell, an interrupt that
        // arrived before this call means `body` is not started at all.
        run(body: () -> RUN_RESULT) -> CELL_RUN is
            let begun = _interrupt
            let interrupt = begun ?? ManualResetEventSlim(false)

            if interrupt.is_set then
                return CELL_RUN(null, null, true)
            fi

            let finished = ManualResetEventSlim(false)

            let outcome: RUN_RESULT? mut = null

            let start: System.Threading.ThreadStart = () -> void is
                try
                    outcome = body()
                catch e: System.Exception
                    outcome = RUN_RESULT(null, e.message)
                finally
                    finished.set()
                yrt
            si

            let thread = Thread(start, STACK_SIZE)

            thread.is_background = true
            thread.name = "ghul cell"

            _interrupt = interrupt

            try
                thread.start()

                WaitHandle.wait_any([finished.wait_handle, interrupt.wait_handle])
            finally
                if !begun? then
                    _interrupt = null
                fi
            yrt

            if finished.is_set then
                if let result = outcome then
                    return CELL_RUN(result.value, result.error, false)
                fi

                return CELL_RUN(null, null, false)
            fi

            return CELL_RUN(null, null, true)
        si

        // Stops the cell in progress: at once if it is running, before it
        // starts if it is still being compiled. False when no cell is in
        // progress. Safe to call from any thread, a signal handler's
        // included.
        interrupt() -> bool is
            if let current = _interrupt then
                current.set()

                return true
            fi

            return false
        si
    si
si
