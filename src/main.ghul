namespace Ghul.Cli is
    use Ghul.Cli.Repl
    use Host = Ghul.Repl.Host

    use IO.Std
    use IO.File
    use IO.Directory
    use IO.Path
    use IO.FileMode
    use IO.FileAccess
    use IO.FileShare
    use IO.UnixFileMode
    use Ghul.Pipes.map
    use Ghul.Pipes.first

    home_directory() -> string is
        let home = System.Environment.get_environment_variable("HOME")

        assert home? else "ghul: the HOME environment variable is not set";

        return home
    si

    tools_directory() -> string => "{home_directory()}/.local/share/ghul-cli/tools"

    cache_root() -> string is
        let xdg = System.Environment.get_environment_variable("XDG_CACHE_HOME")

        if xdg? /\ xdg.length > 0 then
            return "{xdg}/ghul-cli/scripts"
        fi

        return "{home_directory()}/.cache/ghul-cli/scripts"
    si

    // Keyed on the source's own bytes plus the compiler version that will
    // build it, so a compiler update invalidates every cached script rather
    // than serving a binary built by a version that no longer matches.
    cache_entry_dir_for_bytes(bytes: ubyte[], compiler_version: string) -> string is
        let digest = System.Security.Cryptography.SHA256.hash_data(bytes)
        let hex = System.Convert.to_hex_string(digest).to_lower()

        return "{cache_root()}/{hex}-{compiler_version}"
    si

    cache_entry_dir(script_path: string, compiler_version: string) -> string =>
        cache_entry_dir_for_bytes(File.read_all_bytes(script_path), compiler_version)

    installed_compiler_version(tools_dir: string) -> string? is
        let store_dir = "{tools_dir}/.store/ghul.compiler"

        if !Directory.exists(store_dir) then
            return null
        fi

        let versions = Directory.get_directories(store_dir)

        if versions.count == 0 then
            return null
        fi

        return Path.get_file_name(versions[0])
    si

    // The conventional stdin marker: a lone `-` names standard input rather
    // than a file, matching every other CLI that reads a script this way. A
    // real file named `-` is reached by qualifying the path (`./-`), the
    // same escape every other tool that follows this convention needs too.
    is_stdin_marker(script_ref: string) -> bool => script_ref =~ "-"

    is_readable(path: string) -> bool is
        try
            let stream = File.open_read(path)
            stream.close()
            return true
        catch e: System.Exception
            return false
        yrt
    si

    is_executable(path: string) -> bool is
        try
            let mode = File.get_unix_file_mode(path)
            return (cast int(mode) & cast int(UnixFileMode.USER_EXECUTE)) != 0
        catch e: System.Exception
            return false
        yrt
    si

    starts_with_shebang(path: string) -> bool is
        try
            let reader = File.open_text(path)
            let first = reader.read()
            let second = reader.read()
            reader.close()
            return first == 35 /\ second == 33  // '#' then '!'
        catch e: System.Exception
            return false
        yrt
    si

    // The default (no explicit verb) rules: a readable file ending in
    // `.ghul` runs regardless of its executable bit, and a readable
    // executable file starting `#!` runs regardless of its extension -
    // covering both `ghul script.ghul` and a chmod +x'd shebang script
    // invoked as `./script`. Anything else needs an explicit `run`.
    is_runnable_by_default(path: string) -> bool is
        if !is_readable(path) then
            return false
        fi

        if path.ends_with(".ghul") then
            return true
        fi

        return is_executable(path) /\ starts_with_shebang(path)
    si

    // Opens an exclusive advisory lock on `lock_path`, blocking until it is
    // free. The lock is held for as long as the returned stream stays open;
    // closing it (including via process exit) releases it immediately, so
    // a crashed holder can never leave a stale lock behind the way a
    // lock-file-existence check would.
    acquire_lock(lock_path: string, waiting_message: string?) -> IO.FileStream is
        Directory.create_directory(Path.get_directory_name(lock_path) ?? ".")

        let announced mut = false

        do
            try
                return File.open(lock_path, FileMode.OPEN_OR_CREATE, FileAccess.READ_WRITE, FileShare.NONE)
            catch e: IO.IOException
                if !announced then
                    if let message: string = waiting_message then
                        Std.error.write_line(message)
                    fi

                    announced = true
                fi

                System.Threading.Thread.sleep(100)
            yrt
        od
    si

    install_compiler(tools_dir: string, version: string?, show_output: bool) -> bool is
        Directory.create_directory(tools_dir)

        let start_info = System.Diagnostics.ProcessStartInfo()
        start_info.file_name = "dotnet"
        start_info.use_shell_execute = false
        start_info.argument_list.add("tool")

        if installed_compiler_version(tools_dir)? then
            start_info.argument_list.add("update")
        else
            start_info.argument_list.add("install")
        fi

        start_info.argument_list.add("--tool-path")
        start_info.argument_list.add(tools_dir)

        if let v: string = version then
            start_info.argument_list.add("--version")
            start_info.argument_list.add(v)

            // A named version is the one wanted, older or not, and an
            // update refuses to go backwards unless told it can.
            if installed_compiler_version(tools_dir)? then
                start_info.argument_list.add("--allow-downgrade")
            fi
        fi

        start_info.argument_list.add("ghul.compiler")

        // For a script run, dotnet's own install chatter (and, on a fresh
        // machine, its first-time-experience banner) is captured and only
        // surfaced on failure, so it never contends with the run script's
        // own stdout. An explicit `install-compiler` has nothing else
        // writing to the console, so it is left to stream straight through.
        if !show_output then
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true
        fi

        if let process: System.Diagnostics.Process = System.Diagnostics.Process.start(start_info) then
            if !show_output then
                let stdout_task = process.standard_output.read_to_end_async()
                let stderr_task = process.standard_error.read_to_end_async()

                process.wait_for_exit()

                if process.exit_code == 0 then
                    return true
                fi

                Std.error.write(stdout_task.result)
                Std.error.write(stderr_task.result)

                return false
            fi

            process.wait_for_exit()

            return process.exit_code == 0
        fi

        Std.error.write_line("ghul: failed to install ghul.compiler")
        return false
    si

    // Double-checked: a cheap unlocked look first (the overwhelmingly
    // common case is "already installed and matches"), then the same
    // check again once the lock is held, since another process may have
    // finished installing while we were waiting for it.
    ensure_compiler_installed(tools_dir: string, version: string?, show_output: bool) -> string? is
        if let current: string = installed_compiler_version(tools_dir) then
            if !version? \/ current =~ version then
                return current
            fi
        fi

        Directory.create_directory(tools_dir)

        let lock_stream = acquire_lock(
            "{tools_dir}/.install.lock",
            "ghul: waiting for another ghul process to finish installing the compiler...")

        try
            if let current: string = installed_compiler_version(tools_dir) then
                if !version? \/ current =~ version then
                    return current
                fi
            fi

            if !install_compiler(tools_dir, version, show_output) then
                return null
            fi

            return installed_compiler_version(tools_dir)
        finally
            lock_stream.close()
        yrt
    si

    compile_script_into(compiler_shim: string, script_path: string, run_dir: string, tools_dir: string, compiler_version: string) -> bool is
        Directory.create_directory(run_dir)

        let output = "{run_dir}/run.exe"

        let start_info = System.Diagnostics.ProcessStartInfo()
        start_info.file_name = compiler_shim
        start_info.use_shell_execute = false
        start_info.argument_list.add(script_path)
        start_info.argument_list.add("-o")
        start_info.argument_list.add(output)

        if let process: System.Diagnostics.Process = System.Diagnostics.Process.start(start_info) then
            process.wait_for_exit()

            if process.exit_code != 0 then
                return false
            fi

            // Every ghul.compiler tool package carries ghul-runtime.dll beside
            // its own dll; a compiled script needs a copy sitting beside it too.
            let runtime_dll = "{tools_dir}/.store/ghul.compiler/{compiler_version}/ghul.compiler/{compiler_version}/tools/net10.0/any/ghul-runtime.dll"

            if File.exists(runtime_dll) then
                File.copy(runtime_dll, "{run_dir}/ghul-runtime.dll", true)
            fi

            return true
        fi

        Std.error.write_line("ghul: failed to start the compiler")
        return false
    si

    // Writes `bytes` (a script read from stdin) into a `.ghul` file inside
    // `scratch_dir` so it has a real path to hand the compiler.
    materialize_bytes(bytes: ubyte[], scratch_dir: string) -> string is
        Directory.create_directory(scratch_dir)

        let path = "{scratch_dir}/source.ghul"

        File.write_all_bytes(path, bytes)

        return path
    si

    // Compiles into a fresh, uniquely-named scratch directory and only
    // then renames it onto `run_dir`. Directory.move is a single rename on
    // the same filesystem, so a concurrent reader's `File.exists(output)`
    // check never observes a half-written entry, and a crash mid-compile
    // never leaves one behind either.
    //
    // Guarded by a per-cache-entry lock so two processes compiling the
    // same script under the same compiler version serialise on the work
    // rather than both compiling it, but correctness does not depend on
    // the lock: whichever rename loses (because the other process's
    // rename already landed) just discards its now-redundant scratch copy.
    //
    // `materialize` is handed the scratch directory and returns the actual
    // `.ghul` file to compile - either the caller's own persistent path
    // (ignoring the scratch directory), or a file freshly written into it
    // (for a script read from stdin, which has no path of its own).
    //
    // `force` skips the "already compiled" fast path and, once a fresh
    // compile has succeeded, discards whatever is already at `run_dir`
    // before the rename - the explicit `--no-cache` escape hatch.
    ensure_compiled(compiler_shim: string, materialize: (string) -> string, run_dir: string, tools_dir: string, compiler_version: string, force: bool) -> bool is
        let output = "{run_dir}/run.exe"

        if !force /\ File.exists(output) then
            return true
        fi

        Directory.create_directory(cache_root())

        let lock_path = "{cache_root()}/.locks/{Path.get_file_name(run_dir)}.lock"
        let lock_stream = acquire_lock(lock_path, null)

        try
            if !force /\ File.exists(output) then
                return true
            fi

            let scratch_dir = "{run_dir}.tmp-{System.Environment.process_id}-{System.Guid.new_guid().to_string("N")}"
            let script_path = materialize(scratch_dir)

            if !compile_script_into(compiler_shim, script_path, scratch_dir, tools_dir, compiler_version) then
                if Directory.exists(scratch_dir) then
                    Directory.delete(scratch_dir, true)
                fi

                return false
            fi

            if force /\ Directory.exists(run_dir) then
                Directory.delete(run_dir, true)
            fi

            try
                Directory.move(scratch_dir, run_dir)
            catch e: IO.IOException
                // Another process finished first and already holds run_dir;
                // its copy is complete, ours is now redundant.
                Directory.delete(scratch_dir, true)
            yrt

            return File.exists(output)
        finally
            lock_stream.close()
        yrt
    si

    run_script(output: string, script_args: Collections.List[string]) -> int is
        let start_info = System.Diagnostics.ProcessStartInfo()
        start_info.file_name = "dotnet"
        start_info.use_shell_execute = false
        start_info.argument_list.add(output)

        for a in script_args do
            start_info.argument_list.add(a)
        od

        if let process: System.Diagnostics.Process = System.Diagnostics.Process.start(start_info) then
            process.wait_for_exit()
            return process.exit_code
        fi

        Std.error.write_line("ghul: failed to run the compiled script")
        return 1
    si

    read_all_stdin_bytes() -> ubyte[] is
        let stdin = Std.open_standard_input()
        let buffer = IO.MemoryStream()

        stdin.copy_to(buffer)

        return buffer.to_array()
    si

    // Resolves a script reference - a real path, or the `-` stdin marker -
    // into the bytes that key its cache entry and a `materialize` function
    // that produces a real `.ghul` file to compile. Callers must already
    // have confirmed the reference exists (or is the stdin marker).
    //
    // ghul.compiler's own argument parser only recognises a source file by
    // its `.ghul` extension, so a script reached without one - the stdin
    // marker, or an extensionless executable with a `#!` line - has its
    // content copied into a `.ghul`-suffixed file before compiling, same as
    // stdin. A path that already ends in `.ghul` is handed to the compiler
    // unchanged.
    resolve_source(script_ref: string) -> (materialize: (string) -> string, key_bytes: ubyte[]) is
        if is_stdin_marker(script_ref) then
            let bytes = read_all_stdin_bytes()

            return (materialize = scratch_dir => materialize_bytes(bytes, scratch_dir), key_bytes = bytes)
        fi

        let bytes = File.read_all_bytes(script_ref)

        if script_ref.ends_with(".ghul") then
            return (materialize = (_: string) => script_ref, key_bytes = bytes)
        fi

        return (materialize = scratch_dir => materialize_bytes(bytes, scratch_dir), key_bytes = bytes)
    si

    cli_version() -> string is
        let assembly_version =
            System.Reflection.Assembly
                .get_executing_assembly()
                .get_custom_attributes(typeof System.Reflection.AssemblyInformationalVersionAttribute, false)
                    |> map(va => cast System.Reflection.AssemblyInformationalVersionAttribute?(va)!)
                    |> first()

        if assembly_version? then
            return assembly_version.informational_version
        fi

        return "0.0.0-unknown"
    si

    print_usage() is
        Std.error.write_line("usage: ghul [--no-cache] [--] <script> [args...]")
        Std.error.write_line("       ghul run [--no-cache] <script> [args...]")
        Std.error.write_line("       ghul compile [--no-cache] <script.ghul>")
        Std.error.write_line("       ghul install-compiler [version]")
        Std.error.write_line("       ghul cache clear")
        Std.error.write_line("       ghul repl")
        Std.error.write_line("       ghul version")
        Std.error.write_line("       a `-` in place of <script> reads the source from stdin")
    si

    cmd_install_compiler(rest: Collections.List[string]) -> int is
        let version: string? = if rest.count > 0 then rest[0] else null fi
        let tools_dir = tools_directory()

        let before = installed_compiler_version(tools_dir)

        if let current: string = before /\ version? /\ current =~ version then
            Std.error.write_line("ghul: ghul.compiler {current} is already installed")
            return 0
        fi

        // With no version named, the latest is wanted whatever is
        // installed, so an installed compiler does not end the matter
        // the way it does for a script run.
        if before? /\ !version? then
            Std.error.write_line("ghul: checking for a newer ghul.compiler than {before}...")

            if let installed: string = update_compiler_to_latest(tools_dir) then
                if installed =~ before then
                    Std.error.write_line("ghul: ghul.compiler {installed} is already installed and is the latest")
                else
                    Std.error.write_line("ghul: ghul.compiler updated from {before} to {installed}")
                fi

                return 0
            fi

            Std.error.write_line("ghul: failed to update ghul.compiler")
            return 1
        fi

        Std.error.write_line("ghul: installing ghul.compiler{if version? then " {version}" else "" fi}...")

        if let installed: string = ensure_compiler_installed(tools_dir, version, true) then
            Std.error.write_line("ghul: ghul.compiler {installed} is installed")
            return 0
        fi

        Std.error.write_line("ghul: failed to install ghul.compiler")
        return 1
    si

    // Under the install lock, since a script run elsewhere may be
    // installing or reading the compiler at the same time.
    update_compiler_to_latest(tools_dir: string) -> string? is
        let lock_stream = acquire_lock(
            "{tools_dir}/.install.lock",
            "ghul: waiting for another ghul process to finish installing the compiler...")

        try
            if !install_compiler(tools_dir, null, true) then
                return null
            fi

            return installed_compiler_version(tools_dir)
        finally
            lock_stream.close()
        yrt
    si

    cmd_cache(rest: Collections.List[string]) -> int is
        if rest.count < 1 \/ rest[0] !~ "clear" then
            Std.error.write_line("usage: ghul cache clear")
            return 1
        fi

        let root = cache_root()

        if Directory.exists(root) then
            Directory.delete(root, true)
        fi

        Std.error.write_line("ghul: cache cleared ({root})")
        return 0
    si

    cmd_version() -> int is
        Std.out.write_line("ghul {cli_version()}")

        let tools_dir = tools_directory()

        if let compiler_version: string = installed_compiler_version(tools_dir) then
            Std.out.write_line("ghul.compiler {compiler_version}")
        else
            Std.out.write_line("ghul.compiler not installed")
        fi

        return 0
    si

    cmd_compile(rest: Collections.List[string], no_cache: bool) -> int is
        if rest.count < 1 then
            Std.error.write_line("usage: ghul compile [--no-cache] <script.ghul>")
            return 1
        fi

        let script_ref = rest[0]

        if !is_stdin_marker(script_ref) /\ !File.exists(script_ref) then
            Std.error.write_line("ghul: no such file: {script_ref}")
            return 1
        fi

        let source = resolve_source(script_ref)
        let tools_dir = tools_directory()

        if let compiler_version: string = ensure_compiler_installed(tools_dir, null, false) then
            let compiler_shim = "{tools_dir}/ghul-compiler"
            let run_dir = cache_entry_dir_for_bytes(source.key_bytes, compiler_version)

            if !ensure_compiled(compiler_shim, source.materialize, run_dir, tools_dir, compiler_version, no_cache) then
                return 1
            fi

            Std.out.write_line("{run_dir}/run.exe")
            return 0
        fi

        Std.error.write_line("ghul: could not install ghul.compiler")
        return 1
    si

    cmd_run(rest: Collections.List[string], force: bool, no_cache: bool) -> int is
        if rest.count < 1 then
            print_usage()
            return 1
        fi

        let script_ref = rest[0]
        let script_args = rest[1..<0]

        if !is_stdin_marker(script_ref) /\ !File.exists(script_ref) then
            Std.error.write_line("ghul: no such file: {script_ref}")
            return 1
        fi

        if !force /\ !is_stdin_marker(script_ref) /\ !is_runnable_by_default(script_ref) then
            Std.error.write_line(
                "ghul: refusing to run {script_ref}: not a .ghul file and not an executable script starting with '#!' - use 'ghul run {script_ref}' to force it")
            return 1
        fi

        let source = resolve_source(script_ref)
        let tools_dir = tools_directory()

        if let compiler_version: string = ensure_compiler_installed(tools_dir, null, false) then
            let compiler_shim = "{tools_dir}/ghul-compiler"
            let run_dir = cache_entry_dir_for_bytes(source.key_bytes, compiler_version)

            if !ensure_compiled(compiler_shim, source.materialize, run_dir, tools_dir, compiler_version, no_cache) then
                return 1
            fi

            return run_script("{run_dir}/run.exe", script_args)
        fi

        Std.error.write_line("ghul: could not determine the installed ghul.compiler version")
        return 1
    si

    // `--no-cache` is documented (and accepted) in two positions: before
    // everything, or immediately after the `run`/`compile` verb. Strips it
    // from the front of `list` if present, returning what's left alongside
    // whether it was found.
    strip_no_cache(list: Collections.List[string]) -> (items: Collections.List[string], no_cache: bool) is
        if list.count > 0 /\ list[0] =~ "--no-cache" then
            return (items = list[1..<0], no_cache = true)
        fi

        return (items = list, no_cache = false)
    si

    // The oldest compiler the session can be built on: `--submission`,
    // which names the cell's namespace and answers with the value it
    // ended on, `--check-complete`, which says whether what has been
    // typed is finished, and `--compile-server`, which keeps one compiler
    // running for the session, answers that same question, and imports
    // a type whose base is in another cell.
    MINIMUM_REPL_COMPILER: string => "59.8.0"

    // Whether what is installed is old enough to be missing something
    // the session needs. A version that does not parse is left alone:
    // it is a build of the compiler rather than a release, and whoever
    // installed it knows what it is.
    is_too_old_for_repl(version: string) -> bool is
        let installed: System.Version? mut
        let minimum: System.Version? mut

        if
            !System.Version.try_parse(version, installed ref) \/ !installed? \/
            !System.Version.try_parse(MINIMUM_REPL_COMPILER, minimum ref) \/ !minimum?
        then
            return false
        fi

        return installed < minimum
    si

    // What `ghul repl` was asked for.
    class REPL_OPTIONS(want_server: bool, want_default_use: bool, theme: Repl.ThemeChoice) is
        // Null when an argument is not one the session takes.
        parse(args: Collections.List[string]) -> REPL_OPTIONS? static is
            let want_server mut = true
            let want_default_use mut = true
            let theme mut = Repl.ThemeChoice.AUTO
            let i mut = 0

            while i < args.count do
                case args[i]
                when "--no-server" then
                    want_server = false
                when "--no-default-use" then
                    want_default_use = false
                when "--theme" then
                    i = i + 1

                    if i >= args.count then
                        return null
                    fi

                    case args[i]
                    when "dark" then
                        theme = Repl.ThemeChoice.DARK
                    when "light" then
                        theme = Repl.ThemeChoice.LIGHT
                    when "none" then
                        theme = Repl.ThemeChoice.NONE
                    else
                        return null
                    esac
                else
                    return null
                esac

                i = i + 1
            od

            return REPL_OPTIONS(want_server, want_default_use, theme)
        si
    si

    cmd_repl(args: Collections.List[string]) -> int is
        let options = REPL_OPTIONS.parse(args)

        if !options? then
            Std.error.write_line("usage: ghul repl [--no-server] [--no-default-use] [--theme dark|light|none]")

            return 1
        fi

        let tools_dir = tools_directory()

        if let installed: string = installed_compiler_version(tools_dir) /\ is_too_old_for_repl(installed) then
            Std.error.write_line(
                "ghul: the session needs ghul.compiler {MINIMUM_REPL_COMPILER} or newer; {installed} is installed")

            Std.error.write_line("ghul: run ghul install-compiler to update it")

            return 1
        fi

        if let compiler_version: string = ensure_compiler_installed(tools_dir, null, false) then
            let compiler_shim = "{tools_dir}/ghul-compiler"

            let runtime_assembly =
                "{tools_dir}/.store/ghul.compiler/{compiler_version}/ghul.compiler/{compiler_version}/tools/net10.0/any/ghul-runtime.dll"

            let say = (line: string) -> void => Std.error.write_line(line)

            let make_session = () -> Host.HOSTED_SESSION =>
                Host.HOST_SESSIONS.start(
                    compiler_shim,
                    runtime_assembly,
                    options.want_server,
                    options.want_default_use,
                    say)

            let terminal =
                Repl.TERMINAL(make_session, options.want_default_use, options.theme)

            return run_closing_on_signal(terminal)
        fi

        return 1
    si

    // The compile server also ends by itself once this process has gone
    // and its input closes; closing it on a signal makes that immediate
    // rather than whenever it next reads.
    run_closing_on_signal(terminal: Repl.TERMINAL) -> int is
        let on_signal = (context: System.Runtime.InteropServices.PosixSignalContext) -> void => terminal.close()

        let use interrupt = System.Runtime.InteropServices.PosixSignalRegistration.create(
            System.Runtime.InteropServices.PosixSignal.SIGINT, on_signal)

        let use terminate = System.Runtime.InteropServices.PosixSignalRegistration.create(
            System.Runtime.InteropServices.PosixSignal.SIGTERM, on_signal)

        let use hang_up = System.Runtime.InteropServices.PosixSignalRegistration.create(
            System.Runtime.InteropServices.PosixSignal.SIGHUP, on_signal)

        return terminal.run()
    si

    entry(args: string[]) -> int is
        if args.count < 1 then
            print_usage()
            return 1
        fi

        let leading = strip_no_cache(args[0..<0])
        let items mut = leading.items
        let no_cache mut = leading.no_cache

        if items.count < 1 then
            print_usage()
            return 1
        fi

        // `--` ends verb parsing, the same convention every other CLI uses,
        // so a script literally named `run`, `compile`, `cache` or
        // `install-compiler` can still be reached by the default verb.
        if items[0] =~ "--" then
            let after_dashdash = strip_no_cache(items[1..<0])

            return cmd_run(after_dashdash.items, false, no_cache \/ after_dashdash.no_cache)
        fi

        let verb = items[0]
        let rest = items[1..<0]

        if verb =~ "install-compiler" then
            return cmd_install_compiler(rest)
        fi

        if verb =~ "compile" then
            let after_verb = strip_no_cache(rest)

            return cmd_compile(after_verb.items, no_cache \/ after_verb.no_cache)
        fi

        if verb =~ "run" then
            let after_verb = strip_no_cache(rest)

            return cmd_run(after_verb.items, true, no_cache \/ after_verb.no_cache)
        fi

        if verb =~ "cache" then
            return cmd_cache(rest)
        fi

        if verb =~ "repl" then
            return cmd_repl(rest)
        fi

        if verb =~ "version" \/ verb =~ "--version" then
            return cmd_version()
        fi

        return cmd_run(items, false, no_cache)
    si
si
