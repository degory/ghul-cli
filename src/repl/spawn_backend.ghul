namespace Ghul.Cli.Repl is
    use Collections.LIST
    use Ghul.Repl.CELL_REQUEST
    use IO.Directory
    use IO.File
    use IO.Path

    // What compiling one cell produced: where the assembly was written,
    // where it compiled, and the compiler's own diagnostic lines.
    class COMPILE_RESULT(assembly_path: string?, diagnostics: Collections.List[string]) is
        is_success: bool => assembly_path?
    si

    // Compiles each cell by spawning the compiler, the way the rest of
    // this tool does. About a second a cell, nearly all of it process
    // start-up and building the metadata context over the reference
    // pack, which is why a resident backend is what the latency target
    // eventually needs.
    class SPAWN_BACKEND(_compiler_shim: string, _session_directory: string, _runtime_assembly: string?) is
        // The file a cell of the given name is written to. The compiler
        // records a reference under the referenced file's own name, so a
        // later cell's generated import only resolves while the assembly
        // and the submission share one name.
        assembly_path(name: string) -> string =>
            Path.join([_session_directory, "{name}.dll"])

        compile(request: CELL_REQUEST) -> COMPILE_RESULT is
            Directory.create_directory(_session_directory)

            // A cell's assembly references the ghūl runtime, and the
            // host process that loads it has to be able to find it: its
            // own copy is whatever version this tool was built against,
            // which is not the version the cells were compiled against.
            if let runtime = _runtime_assembly /\ File.exists(runtime) then
                let beside_cells = Path.join([_session_directory, Path.get_file_name(runtime)!])

                if !File.exists(beside_cells) then
                    File.copy(runtime, beside_cells, false)
                fi
            fi

            let source_path = Path.join([_session_directory, "{request.name}.ghul"])
            let output_path = assembly_path(request.name)

            File.write_all_text(source_path, request.source)

            let start_info = System.Diagnostics.ProcessStartInfo()

            start_info.file_name = _compiler_shim
            start_info.use_shell_execute = false
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true
            start_info.working_directory = _session_directory

            start_info.argument_list.add("--library")

            // What the cell's namespace is called, which decides what
            // the generated imports of every later cell name. Without
            // it the compiler would derive one from the file's path.
            start_info.argument_list.add("--submission")
            start_info.argument_list.add(request.name)

            // `--reference` adds to the references the compiler finds for
            // itself, where `-a` would replace them and leave the cell
            // without the framework's.
            for reference in request.references do
                start_info.argument_list.add("--reference")
                start_info.argument_list.add(assembly_path(reference))
            od

            start_info.argument_list.add("-o")
            start_info.argument_list.add(output_path)
            start_info.argument_list.add(source_path)

            let diagnostics = LIST[string]()

            if let process = System.Diagnostics.Process.start(start_info) then
                // Both streams are read at once, as everything else here
                // that redirects a child's output does: reading one to
                // the end first deadlocks as soon as the other fills its
                // pipe buffer, which a cell with a long diagnostic dump
                // does.
                let out_task = process.standard_output.read_to_end_async()
                let err_task = process.standard_error.read_to_end_async()

                process.wait_for_exit()

                let out = out_task.result
                let err = err_task.result

                for line in "{err}{out}".split(['\n']) do
                    let trimmed = line.trim()

                    if trimmed.length > 0 /\ !trimmed.starts_with("***") /\ !trimmed.starts_with("!!!") then
                        diagnostics.add(trimmed)
                    fi
                od

                if process.exit_code == 0 /\ File.exists(output_path) then
                    return COMPILE_RESULT(output_path, diagnostics)
                fi

                return COMPILE_RESULT(null, diagnostics)
            fi

            diagnostics.add("ghul: failed to start the compiler")

            return COMPILE_RESULT(null, diagnostics)
        si
    si

    // Every session directory starts with this, so the namespace the
    // compiler derives from a cell's path is a plain identifier.
    REPL_SESSION_PREFIX: string => "ghulrepl_"
si
