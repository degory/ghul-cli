namespace Ghul.Cli.Repl is
    use Collections.LIST
    use Ghul.Repl.CELL_DISPLAY
    use IO.Std
    use Ghul.Repl.Host.Completeness
    use Ghul.Repl.Host.HOSTED_SESSION
    use Ghul.Repl.Host.SUBMIT_RESULT

    // Whether the lines typed so far are a submission, asked of the
    // compiler each time a line is entered. Text it calls unfinished - an
    // open block, an open bracket, an operator with nothing after it -
    // waits for another line; anything else is submitted, including text
    // that can never be finished, so its errors are reported straight
    // away rather than after a blank line. A blank line submits whatever
    // there is regardless.
    class SUBMISSION_END(_check: (string) -> Completeness) is
        // Whether a blank line was entered after something was typed,
        // which submits what is there without asking.
        is_forced(lines: Collections.List[string], latest: string) -> bool =>
            latest.trim().length == 0 /\ !_is_blank(lines)

        // Whether the lines with the latest one added make a submission.
        is_complete(lines: Collections.List[string], latest: string) -> bool is
            if latest.trim().length == 0 then
                return false
            fi

            let text = "{lines |> Ghul.Pipes.cat([latest]) |> Ghul.Pipes.join("\n")}\n"

            return _check(text) != Completeness.INCOMPLETE
        si

        _is_blank(lines: Collections.List[string]) -> bool is
            for line in lines do
                if line.trim().length > 0 then
                    return false
                fi
            od

            return true
        si
    si

    // The terminal front end: read a submission, hand it to the session,
    // report what happened. Everything it knows about a cell it learns
    // from SESSION, so a notebook or the playground can take its place
    // without any of this.
    class TERMINAL(_make_session: () -> HOSTED_SESSION, _want_default_use: bool) is
        _display: CELL_DISPLAY
        _current: HOSTED_SESSION?

        _submission_end: SUBMISSION_END

        // Lines are edited in place when a person is typing them at a
        // terminal, and read as they come otherwise.
        _reader: LineReader

        init(..) is
            _display = CELL_DISPLAY()

            // Asked of the session in use, whose compile server answers
            // it once it is ready.
            _submission_end = SUBMISSION_END(text => if let session = _current then session.check(text) else Completeness.COMPLETE fi)

            _reader =
                if Std.is_input_redirected \/ Std.is_output_redirected then
                    PLAIN_READER()
                else
                    CONSOLE_EDITOR((text, line, column) => _names(text, line, column))
                fi
        si

        run() -> int is
            Std.write_line("ghūl repl. :help for commands.")

            let session mut = _make_session()

            _current = session
            let lines = LIST[string]()

            loop: do
                let line = _reader.read_line(if lines.count == 0 then "> " else "| " fi, lines)

                if !line? then
                    Std.write_line("")

                    break loop
                fi

                if lines.count == 0 /\ line.trim().starts_with(":") then
                    case line.trim()
                    when ":quit", ":q" then
                        break loop
                    when ":reset" then
                        session.close()
                        session = _make_session()
                        _current = session

                        Std.write_line("session reset")
                    when ":help" then
                        _write_help()
                    else
                        let command = line.trim()

                        if command.starts_with(":complete ") then
                            _complete(session, command.substring(":complete ".length))
                        elif command.starts_with(":hover ") then
                            _hover(session, command.substring(":hover ".length))
                        else
                            Std.write_line("unknown command {command}; :help for the list")
                        fi
                    esac

                    continue
                fi

                if lines.count == 0 /\ line.trim().length == 0 then
                    continue
                fi

                if _submission_end.is_complete(lines, line) then
                    lines.add(line)
                elif !_submission_end.is_forced(lines, line) then
                    lines.add(line)

                    continue
                fi

                let source = "{lines |> Ghul.Pipes.join("\n")}\n"

                lines.clear()

                _report(session.submit(source))
            od

            session.close()

            return 0
        si

        // For a signal that ends the process: closes the session in use
        // now, whatever the loop is doing.
        close() is
            _current?.close()
        si

        _report(result: SUBMIT_RESULT) is
            for line in result.diagnostics do
                Std.error.write_line(line)
            od

            // After whatever the cell itself wrote, so a cell that
            // prints and then ends on a value reads in the order it ran.
            if let shown = _display.format(result.value) then
                Std.write_line(shown)
            fi

            if let error = result.run_error then
                Std.error.write_line(error)

                // It compiled, so what it declared is there for later
                // cells whatever its own code then did.
                Std.error.write_line("ghul: the cell was kept: it compiled, so its definitions are in the session")
            fi
        si

        _names(text: string, line: int, column: int) -> Collections.List[string]? is
            let offered = _current?.complete(text, line, column)

            if !offered? then
                return null
            fi

            let names = LIST[string]()

            for item in offered do
                names.add(item.name)
            od

            names.sort(System.StringComparer.ordinal)

            return names
        si

        // What could follow some text, one name to a line.
        _complete(session: HOSTED_SESSION, text: string) is
            if let offered = session.complete(text, 1, text.length + 1) then
                let names = LIST[string]()

                for item in offered do
                    names.add(item.name)
                od

                names.sort(System.StringComparer.ordinal)

                for name in names do
                    Std.write_line(name)
                od
            else
                Std.write_line("completion is not available")
            fi
        si

        // The declaration the last character of some text belongs to.
        _hover(session: HOSTED_SESSION, text: string) is
            if let shown = session.hover(text, 1, text.length) then
                Std.write_line(shown)
            elif session.is_analysis_available then
                Std.write_line("nothing there")
            else
                Std.write_line("hover is not available")
            fi
        si

        _write_help() is
            Std.write_line(":help            this list")
            Std.write_line(":reset           start a new session, forgetting every cell")
            Std.write_line(":complete TEXT   what could follow TEXT")
            Std.write_line(":hover TEXT      what the end of TEXT names")
            Std.write_line(":quit            leave")
            Std.write_line("")
            Std.write_line("a line that finishes what you have typed submits it; one that leaves")
            Std.write_line("something open waits for more, and a blank line submits regardless")
            Std.write_line("what you end on is shown, unless you end on a statement")
            Std.write_line("messages call a cell cell-3; in code it is cell3, as in cell3.x")

            if _want_default_use then
                Std.write_line("the compiler's default imports (use default) are in force in every cell")
            fi
        si
    si
si
