namespace Ghul.Cli.Repl is
    use Collections.LIST
    use Collections.SET

    // One accepted submission: what the user wrote, the assembly it
    // compiled to, the namespace it went into, and the names it made
    // visible to later cells. Held for as long as the session lives,
    // since every later cell references the assembly and may import
    // from it.
    class CELL(
        index: int,
        source: string,
        namespace_name: string,
        assembly_path: string,
        exports: Collections.List[string]
    );

    // What a compile backend answers with. An assembly path only where
    // it succeeded; the diagnostics are the compiler's own lines, still
    // carrying the line numbers of the text that was compiled.
    class COMPILE_RESULT(assembly_path: string?, diagnostics: Collections.List[string]) is
        is_success: bool => assembly_path?
    si

    // Somewhere to compile one cell. The session core holds one of
    // these and knows nothing else about how a compile happens, so a
    // resident compiler or the playground's compile service can take
    // the same place later.
    trait CompileBackend open is
        // `source` is the whole cell text, prelude included. `references`
        // are the assemblies of the session's earlier cells, in the
        // order they were accepted.
        compile(
            index: int,
            source: string,
            references: Collections.List[string]
        ) -> COMPILE_RESULT;
    si

    // What a submission did, for a front end to report. A cell that
    // compiled is accepted whatever its own code then did: its
    // definitions exist and later cells can use them, so a cell whose
    // run threw is accepted with the exception reported.
    class SUBMIT_RESULT(
        is_accepted: bool,
        diagnostics: Collections.List[string],
        run_error: string?
    );

    // The session: the cells accepted so far, and what a new submission
    // does to them. No console anywhere in here - a terminal, a
    // notebook kernel and the playground can each drive the same
    // object.
    class SESSION(_backend: CompileBackend, _host: CellHost) is
        _cells: LIST[CELL]

        init(..) is
            _cells = LIST[CELL]()
        si

        cells: Collections.List[CELL] => _cells

        // Every name a new cell can see, and the cell that last defined
        // it. Later cells win, which is what makes a redefinition take
        // effect going forward without any lookup rule changing.
        visible_names() -> Collections.Map[string, CELL] is
            let result = Collections.MAP[string, CELL]()

            for cell in _cells do
                for name in cell.exports do
                    result[name] = cell
                od
            od

            return result
        si

        // One `use` per visible name, naming the cell that last defined
        // it. A name the submission declares itself needs no exclusion:
        // a declaration in the cell already beats an import.
        prelude() -> string is
            let lines = LIST[string]()

            for entry in visible_names() do
                lines.add("use {entry.value.namespace_name}.{entry.key}")
            od

            lines.sort()

            if lines.count == 0 then
                return ""
            fi

            return "{lines |> Ghul.Pipes.join("\n")}\n"
        si

        // Compile a submission, and where it compiles, run it and keep
        // it. A submission that does not compile leaves the session
        // exactly as it was.
        submit(source: string) -> SUBMIT_RESULT is
            let index = _cells.count + 1
            let prelude_text = prelude()
            let prelude_lines = if prelude_text.length == 0 then 0 else prelude_text.split(['\n']).count - 1 fi

            let references = LIST[string]()

            for cell in _cells do
                references.add(cell.assembly_path)
            od

            let result = _backend.compile(index, "{prelude_text}{source}", references)

            let diagnostics = LIST[string]()

            for line in result.diagnostics do
                diagnostics.add(DIAGNOSTIC_LINES.strip_prelude(line, prelude_lines))
            od

            if !result.is_success then
                return SUBMIT_RESULT(false, diagnostics, null)
            fi

            let assembly_path = result.assembly_path!
            let loaded = _host.load(assembly_path)

            _cells.add(
                CELL(
                    index,
                    source,
                    loaded.namespace_name,
                    assembly_path,
                    loaded.exports))

            return SUBMIT_RESULT(true, diagnostics, _host.run(loaded))
        si
    si
si
