namespace Ghul.Cli.Repl is
    use Collections.LIST
    use IO.Std

    // How the terminal reads one line of a submission. `before` is what
    // has been typed of the submission so far, the lines ahead of this one.
    trait LineReader is
        read_line(prompt: string, before: Collections.List[string]) -> string?;
    si

    // A line at a time from standard input, as typed: for input that is
    // not a terminal, which has nobody to edit it.
    class PLAIN_READER: LineReader is
        init() is si

        read_line(prompt: string, before: Collections.List[string]) -> string? is
            Std.write(prompt)

            return Std.read_line()
        si
    si

    // The line being edited, and where in it the cursor is.
    class LINE_BUFFER is
        _text: System.Text.StringBuilder

        cursor: int

        init() is
            _text = System.Text.StringBuilder()
        si

        text: string => _text.to_string()

        insert(value: string) is
            _text.insert(cursor, value)
            cursor = cursor + value.length
        si

        // Backspace in the spaces a line starts with takes the cursor back
        // a whole indent step; anywhere else it deletes one character.
        backspace() is
            if cursor == 0 then
                return
            fi

            let target =
                if is_in_indent then
                    INDENTATION.backspace_column(cursor)
                else
                    cursor - 1
                fi

            _text.remove(target, cursor - target)
            cursor = target
        si

        delete() is
            if cursor < _text.length then
                _text.remove(cursor, 1)
            fi
        si

        left() is
            if cursor > 0 then
                cursor = cursor - 1
            fi
        si

        right() is
            if cursor < _text.length then
                cursor = cursor + 1
            fi
        si

        home() is
            cursor = 0
        si

        end() is
            cursor = _text.length
        si

        // Everything replaced, with the cursor at the end: a line recalled
        // from history.
        replace(value: string) is
            _text.clear()
            _text.append(value)
            cursor = value.length
        si

        // Whether the cursor is in or at the end of the spaces the line
        // starts with.
        is_in_indent: bool => INDENTATION.leading_spaces(text) >= cursor

        // The line re-indented as INDENTATION says, the cursor staying
        // with the text it was in.
        reindent(expected: int) is
            let text = self.text
            let adjusted = INDENTATION.adjust(text, expected)

            if adjusted =~ text then
                return
            fi

            let moved = adjusted.length - text.length

            _text.clear()
            _text.append(adjusted)
            cursor = System.Math.clamp(cursor + moved, 0, adjusted.length)
        si

        // The part of a name the cursor follows, which completion extends.
        name_before_cursor: string is
            let start mut = cursor
            let text = self.text

            while start > 0 /\ (char.is_letter_or_digit(text[start - 1]) \/ text[start - 1] == '_') do
                start = start - 1
            od

            return text.substring(start, cursor - start)
        si

        // What completing a name that starts `typed` adds, given the names
        // on offer: as much as every one of them agrees on beyond what is
        // typed, which is the whole of the rest when there is only one.
        extension(typed: string, names: Collections.List[string]) -> string static is
            if names.count == 0 then
                return ""
            fi

            let common mut = names[0]

            for name in names do
                let length mut = 0

                while length < common.length /\ length < name.length /\ common[length] == name[length] do
                    length = length + 1
                od

                common = common.substring(0, length)
            od

            return if common.length > typed.length then common.substring(typed.length) else "" fi
        si
    si

    // Earlier lines, recalled with the arrow keys, newest last.
    class LINE_HISTORY is
        _lines: LIST[string]
        _position: int

        init() is
            _lines = LIST[string]()
        si

        // A line entered, remembered unless blank or the same as the one
        // before it.
        add(line: string) is
            if line.trim().length > 0 /\ (_lines.count == 0 \/ _lines[_lines.count - 1] !~ line) then
                _lines.add(line)
            fi

            _position = _lines.count
        si

        // The line before the one recalled, or null at the oldest.
        previous() -> string? is
            if _position == 0 then
                return null
            fi

            _position = _position - 1

            return _lines[_position]
        si

        // The line after the one recalled, or the empty line past the
        // newest.
        next() -> string? is
            if _position >= _lines.count then
                return null
            fi

            _position = _position + 1

            return if _position < _lines.count then _lines[_position] else "" fi
        si
    si

    // A line edited in place at the terminal: the arrow keys move and
    // recall, backspace and delete delete, Home and End (or Ctrl-A and
    // Ctrl-E) go to either end, Tab completes, and Ctrl-D on an empty line
    // ends the input. A line starts indented as INDENTATION says, and is
    // coloured as it is typed when there is a palette to colour it with.
    class CONSOLE_EDITOR(_complete: (string, int, int) -> Collections.List[string]?, _palette: PALETTE?): LineReader is
        _history: LINE_HISTORY

        init(..) is
            _history = LINE_HISTORY()
        si

        read_line(prompt: string, before: Collections.List[string]) -> string? is
            let buffer = LINE_BUFFER()
            let expected = INDENTATION.for_next_line(before)

            buffer.insert(string(' ', expected))

            // Cleared once the indent is changed by hand, after which the
            // line keeps whatever indent it is given.
            let is_indent_automatic mut = true

            _redraw(prompt, buffer, before)

            do
                let key = Std.read_key(true)
                let is_control = (key.modifiers & System.ConsoleModifiers.CONTROL) == System.ConsoleModifiers.CONTROL

                case key.key
                when System.ConsoleKey.ENTER then
                    Std.write_line("")

                    _history.add(buffer.text)

                    return buffer.text
                when System.ConsoleKey.BACKSPACE then
                    if buffer.is_in_indent then
                        is_indent_automatic = false
                    fi

                    buffer.backspace()
                when System.ConsoleKey.DELETE then
                    if buffer.is_in_indent then
                        is_indent_automatic = false
                    fi

                    buffer.delete()
                when System.ConsoleKey.LEFT_ARROW then
                    buffer.left()
                when System.ConsoleKey.RIGHT_ARROW then
                    buffer.right()
                when System.ConsoleKey.HOME then
                    buffer.home()
                when System.ConsoleKey.END then
                    buffer.end()
                when System.ConsoleKey.UP_ARROW then
                    if let recalled = _history.previous() then
                        buffer.replace(recalled)
                    fi
                when System.ConsoleKey.DOWN_ARROW then
                    if let recalled = _history.next() then
                        buffer.replace(recalled)
                    fi
                when System.ConsoleKey.TAB then
                    _complete_at(prompt, buffer, before)
                else
                    if is_control /\ key.key == System.ConsoleKey.A then
                        buffer.home()
                    elif is_control /\ key.key == System.ConsoleKey.E then
                        buffer.end()
                    elif is_control /\ key.key == System.ConsoleKey.D then
                        if buffer.text.length == 0 then
                            Std.write_line("")

                            return null
                        fi

                        buffer.delete()
                    elif !is_control /\ key.key_char >= ' ' then
                        buffer.insert(key.key_char.to_string())
                    fi
                esac

                if is_indent_automatic /\ key.key != System.ConsoleKey.UP_ARROW /\ key.key != System.ConsoleKey.DOWN_ARROW then
                    buffer.reindent(expected)
                fi

                _redraw(prompt, buffer, before)
            od
        si

        // One name on offer is written in; several are written in as far
        // as they agree, and listed when they agree no further.
        _complete_at(prompt: string, buffer: LINE_BUFFER, before: Collections.List[string]) is
            let text = before |> Ghul.Pipes.cat([buffer.text]) |> Ghul.Pipes.join("\n")
            let offered = _complete(text, before.count + 1, buffer.cursor + 1)

            if !offered? \/ offered.count == 0 then
                return
            fi

            let typed = buffer.name_before_cursor
            let extension = LINE_BUFFER.extension(typed, offered)

            if extension.length > 0 then
                buffer.insert(extension)
            elif offered.count > 1 then
                Std.write_line("")
                Std.write_line(offered |> Ghul.Pipes.take(60) |> Ghul.Pipes.join("  "))
                _redraw(prompt, buffer, before)
            fi
        si

        // The line written again from the prompt on, cleared to its end,
        // with the cursor put back where it is in the text.
        _redraw(prompt: string, buffer: LINE_BUFFER, before: Collections.List[string]) is
            let text = buffer.text

            Std.write("\r{prompt}{_painted(text, before)}\u001B[K")

            let back = text.length - buffer.cursor

            if back > 0 then
                Std.write("\u001B[{back}D")
            fi
        si

        // The line coloured, read in the light of the lines before it so
        // that a comment or string they leave open carries on into it.
        _painted(text: string, before: Collections.List[string]) -> string is
            if let palette = _palette then
                return palette.paint(text, LINE_SPANS.of_last_line(before, text))
            fi

            return text
        si
    si
si
