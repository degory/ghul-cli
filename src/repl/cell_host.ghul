namespace Ghul.Cli.Repl is
    use Collections.LIST
    use System.Reflection.Assembly
    use System.Reflection.BindingFlags

    // A cell's assembly, loaded: the namespace the compiler put it in,
    // the names later cells can import from it, and the entry to run.
    class LOADED_CELL(
        namespace_name: string,
        exports: Collections.List[string],
        globals: System.Type?
    );

    // Loads each accepted cell into this process and runs it once. One
    // load context for the session rather than one per cell: a later
    // cell references the earlier ones, so none of them can be unloaded
    // while the session lives, and a reset drops the lot with the
    // process.
    class CellHost open is
        load(assembly_path: string) -> LOADED_CELL;

        // What the cell's own code threw, or null where it ran to the
        // end. The cell is accepted either way: it compiled, so its
        // definitions exist for later cells to use.
        run(cell: LOADED_CELL) -> string?;
    si

    // The cells' own load context. The tool is itself a ghūl program, so
    // its process already holds a ghūl runtime - the one it was built
    // against, which is not the one the installed compiler builds cells
    // against, and two versions cannot both be the default. A context of
    // the session's own resolves the cells' runtime beside the cells and
    // leaves the tool's alone. One context for the session rather than
    // one per cell: a later cell references the earlier ones.
    class SESSION_LOAD_CONTEXT: System.Runtime.Loader.AssemblyLoadContext is
        _probe_directory: string?

        init(probe_directory: string?) is
            super.init("ghul-repl", false)

            _probe_directory = probe_directory
        si

        load(name: System.Reflection.AssemblyName) -> Assembly? is
            let directory = _probe_directory

            if !directory? then
                return null
            fi

            if let simple_name = name.name then
                let candidate = IO.Path.join([directory, "{simple_name}.dll"])

                if IO.File.exists(candidate) then
                    return load_from_assembly_path(candidate)
                fi
            fi

            return null
        si
    si

    class REFLECTION_CELL_HOST(_probe_directory: string?): CellHost is
        _context: SESSION_LOAD_CONTEXT

        init(..) is
            _context = SESSION_LOAD_CONTEXT(_probe_directory)
        si

        // The names the compiler gives what a cell declares: everything
        // public and static on the namespace's globals type, less the
        // two entry points the host calls itself, plus every public type
        // in the namespace. The spelling is already ghūl's, so a name
        // goes into a generated `use` as it is read here.
        load(assembly_path: string) -> LOADED_CELL is
            let assembly = _context.load_from_assembly_path(IO.Path.get_full_path(assembly_path))
            let exports = LIST[string]()

            let namespace_name mut = ""
            let globals: System.Type? mut = null

            for type in assembly.get_types() do
                if !type.is_public then
                    continue
                fi

                if let type_namespace = type.namespace then
                    namespace_name = type_namespace
                fi

                if type.name =~ GLOBALS_TYPE_NAME then
                    globals = type
                else
                    exports.add(type.name)
                fi
            od

            if let globals_type = globals then
                let flags = _static_flags(false)

                for method in globals_type.get_methods(flags) do
                    if !_is_entry_point_name(method.name) /\ !exports.contains(method.name) then
                        exports.add(method.name)
                    fi
                od

                for member in globals_type.get_fields(flags) do
                    if !exports.contains(member.name) then
                        exports.add(member.name)
                    fi
                od
            fi

            return LOADED_CELL(namespace_name, exports, globals)
        si

        run(cell: LOADED_CELL) -> string? is
            let globals = cell.globals

            if !globals? then
                return null
            fi

            // `_entry` is the Main-compatible wrapper and the one the
            // runtime would have entered at: it takes the command-line
            // arguments alone. The `entry` beside it is the user-facing
            // shape, which for a cell of top-level statements also
            // carries the process environment, and nothing here can
            // supply one - so it is the fallback, for a cell whose entry
            // needs no wrapper.
            let main = _find_entry(globals)

            if !main? then
                return null
            fi

            let arguments =
                if main.get_parameters().count == 0 then
                    System.Array.empty[object]()
                else
                    [cast object(System.Array.empty[string]())]
                fi

            try
                main.invoke(null, arguments)

                return null
            catch e: System.Reflection.TargetInvocationException
                let inner = e.inner_exception

                return if inner? then "{inner}" else "{e}" fi
            catch e: System.Exception
                return "{e}"
            yrt
        si

        _find_entry(globals: System.Type) -> System.Reflection.MethodInfo? static is
            let methods = globals.get_methods(_static_flags(true))

            for method in methods do
                if method.name =~ MAIN_ENTRY_NAME then
                    return method
                fi
            od

            for method in methods do
                if method.name =~ USER_ENTRY_NAME /\ method.get_parameters().count <= 1 then
                    return method
                fi
            od

            return null
        si

        // The enum's own `|` does not resolve on a reflected
        // `BindingFlags`, so the value is built as the bits it is.
        _static_flags(want_non_public: bool) -> BindingFlags static is
            let flags mut = cast int(BindingFlags.PUBLIC) | cast int(BindingFlags.STATIC)

            if want_non_public then
                flags = flags | cast int(BindingFlags.NON_PUBLIC)
            fi

            return cast BindingFlags(flags)
        si

        _is_entry_point_name(name: string) -> bool static =>
            name =~ MAIN_ENTRY_NAME \/ name =~ USER_ENTRY_NAME
    si

    // What the compiler calls the type holding a namespace's globals,
    // and the two entry points it synthesises for a file of top-level
    // statements.
    GLOBALS_TYPE_NAME: string => "$globals"
    MAIN_ENTRY_NAME: string => "_entry"

    // The runtime every compiled cell references.
    GHUL_RUNTIME_ASSEMBLY: string => "ghul-runtime"
    USER_ENTRY_NAME: string => "entry"
si
