namespace Ghul.Repl is
    use System.Text.RegularExpressions.Regex

    // Where a cell sits in the session, and how many generated lines
    // come before what the user wrote. The last `carried_lines` of those
    // are earlier definitions the cell declares again; what goes wrong
    // there is shown against `anchor_line` of the user's text, saying
    // which definition it was in.
    class CELL_SPAN(index: int, prelude_lines: int) is
        carried_lines: int
        carried_note: string
        anchor_line: int

        init(..) is
            carried_lines = 0
            carried_note = ""
            anchor_line = 1
        si

        init(.., carried_lines: int, carried_note: string, anchor_line: int) is
            self.carried_lines = carried_lines
            self.carried_note = carried_note
            self.anchor_line = anchor_line
        si

        // The lines the session generated for itself.
        is_generated_line(line: int) -> bool => line <= prelude_lines - carried_lines

        is_carried_line(line: int) -> bool => !is_generated_line(line) /\ line <= prelude_lines
    si

    // The compiler is given the generated prelude and the user's text as
    // one file, so every line it reports is that many lines further down
    // than what the user wrote. Subtracting the prelude puts the numbers
    // back where the user can find them.
    class DIAGNOSTIC_LINES is
        // A compiler diagnostic reads `<path>: L,C..L,C: kind: message`.
        // A line at or above the prelude is the session's own doing
        // rather than the user's, and is left alone: it names the
        // generated text, which the user did not write and cannot fix.
        strip_prelude(line: string, prelude_lines: int) -> string static is
            if prelude_lines <= 0 then
                return line
            fi

            let m = Regex.match(line, "^(?<head>.*?): (?<sl>[0-9]+),(?<sc>[0-9]+)\\.\\.(?<el>[0-9]+),(?<ec>[0-9]+): (?<tail>.*)$")

            if !m.success then
                return line
            fi

            let start_line = int.parse(m.groups["sl"].value)
            let end_line = int.parse(m.groups["el"].value)

            if start_line <= prelude_lines then
                return line
            fi

            let head = m.groups["head"].value
            let start_column = m.groups["sc"].value
            let end_column = m.groups["ec"].value
            let tail = m.groups["tail"].value

            "{head}: {start_line - prelude_lines},{start_column}..{end_line - prelude_lines},{end_column}: {tail}"
        si

        // The diagnostic as the user is shown it: every location in a cell
        // of the session, related ones included, names the cell by its
        // label and counts lines from the first the user wrote, using the
        // prelude of the cell it points into. A location in some other
        // file is left as it is. One in a cell's generated prelude points
        // at text the user did not write, so it is reported as the
        // session's own failure instead. Names a cell's namespace
        // qualifies are shown without it.
        for_display(diagnostic: CELL_DIAGNOSTIC, cells: Collections.Map[string, CELL_SPAN]) -> CELL_DIAGNOSTIC static is
            if _is_in_prelude(diagnostic.location, cells) then
                return CELL_DIAGNOSTIC(
                    null,
                    diagnostic.severity,
                    diagnostic.code,
                    "internal: the session prelude failed: {diagnostic.render()}",
                    Collections.LIST[CELL_RELATED]())
            fi

            let related = Collections.LIST[CELL_RELATED]()

            for r in diagnostic.related do
                related.add(CELL_RELATED(without_cell_names(r.message), _for_display(r.location, cells)))
            od

            let message = without_cell_names(diagnostic.message)

            return CELL_DIAGNOSTIC(
                _for_display(diagnostic.location, cells),
                diagnostic.severity,
                diagnostic.code,
                if let note = _carried_note(diagnostic.location, cells) then "in {note}: {message}" else message fi,
                related)
        si

        // A message with each `cellN.` qualifier taken off the names it
        // mentions: the user knows a definition by its name, not by the
        // cell that happened to make it.
        without_cell_names(message: string) -> string static =>
            Regex.replace(message, "\\b{CELL_NAME_STEM}[0-9]+\\.", "")

        // Which carried definition a location is in, for a diagnostic
        // shown against the block that carried it.
        _carried_note(location: CELL_LOCATION?, cells: Collections.Map[string, CELL_SPAN]) -> string? static is
            if !location? then
                return null
            fi

            let file = IO.Path.get_file_name(location.path) ?? ""

            if !file.ends_with(".ghul") then
                return null
            fi

            let name = file.substring(0, file.length - 5)

            if cells.contains_key(name) /\ cells[name].is_carried_line(location.start_line) then
                return cells[name].carried_note
            fi

            return null
        si

        _is_in_prelude(location: CELL_LOCATION?, cells: Collections.Map[string, CELL_SPAN]) -> bool static is
            if !location? then
                return false
            fi

            let file = IO.Path.get_file_name(location.path) ?? ""

            if !file.ends_with(".ghul") then
                return false
            fi

            let name = file.substring(0, file.length - 5)

            return cells.contains_key(name) /\ cells[name].is_generated_line(location.start_line)
        si

        _for_display(location: CELL_LOCATION?, cells: Collections.Map[string, CELL_SPAN]) -> CELL_LOCATION? static is
            if !location? then
                return null
            fi

            let file = IO.Path.get_file_name(location.path) ?? ""

            if !file.ends_with(".ghul") then
                return location
            fi

            let name = file.substring(0, file.length - 5)

            if !cells.contains_key(name) then
                return location
            fi

            let span = cells[name]

            if span.is_carried_line(location.start_line) then
                return CELL_LOCATION(cell_label_for(span.index), span.anchor_line, 1, span.anchor_line, 1)
            fi

            if location.start_line <= span.prelude_lines then
                return location
            fi

            return CELL_LOCATION(
                cell_label_for(span.index),
                location.start_line - span.prelude_lines,
                location.start_column,
                location.end_line - span.prelude_lines,
                location.end_column)
        si
    si
si
