namespace Ghul.Repl is
    use Collections.LIST

    // The `use` directives a submission opens with, found from the text
    // rather than by asking a compiler, since the session compiles
    // nothing. A directive is a line beginning `use`, up to a `;` or the
    // end of the line; blank lines and comment lines between them are
    // passed over, and the first line that is anything else ends them.
    // A directive wrapped over several lines is not recognised, and is
    // compiled with its cell but not carried forward.
    class USE_DIRECTIVES is
        leading(source: string) -> Collections.List[string] static is
            let result = LIST[string]()

            for line in source.split(['\n']) do
                let trimmed = line.trim()

                if trimmed.length == 0 \/ trimmed.starts_with("//") then
                    continue
                fi

                if !_is_use(trimmed) then
                    return result
                fi

                for part in trimmed.split([';']) do
                    let statement = part.trim()

                    if statement.length == 0 then
                        continue
                    fi

                    if !_is_use(statement) then
                        return result
                    fi

                    result.add(normalise(statement))
                od
            od

            return result
        si

        // One space wherever the directive had any run of whitespace, so
        // two spellings of the same import compare equal.
        normalise(directive: string) -> string static =>
            directive.split([' ', '\t'], System.StringSplitOptions.REMOVE_EMPTY_ENTRIES)
            |> Ghul.Pipes.join(" ")

        // The name a directive brings into scope, or null for one that
        // brings in a set of names - a wildcard, or `use default`. Two
        // directives binding the same name are a duplicate even when they
        // name different things, so the session keeps one per name.
        bound_name(directive: string) -> string? static is
            let body = directive.substring(3).trim()

            let equals = body.index_of('=')

            if equals >= 0 then
                let name = body.substring(0, equals).trim()
                let bracket = name.index_of('[')

                return if bracket >= 0 then name.substring(0, bracket).trim() else name fi
            fi

            if body =~ "default" \/ body.ends_with(".*") then
                return null
            fi

            let dot = body.last_index_of('.')

            let name = if dot >= 0 then body.substring(dot + 1) else body fi

            return if name.starts_with("`") then name.substring(1) else name fi
        si

        _is_use(text: string) -> bool static =>
            text.length > 3 /\ text.starts_with("use") /\ (text[3] == ' ' \/ text[3] == '\t')
    si
si
