namespace Ghul.Repl is
    use Collections.LIST

    // One accepted submission: the name its namespace and its assembly
    // take, what the user wrote, and the names it made visible to later
    // cells. Held for as long as the session lives, since every later
    // cell references it and may import from it.
    class CELL(
        index: int,
        name: string,
        source: string,
        exports: Collections.List[string]
    );

    // What a host has to compile, and nothing about how. The source is
    // the whole cell text, generated prelude included. The prelude's
    // last `carried_line_count` lines are the earlier definitions of the
    // types in `carried_names`, which the cell adds to with partial or
    // impl blocks and so has to declare again. The references
    // are the names of the session's earlier cells, in the order they
    // were accepted, which the host maps to whatever it holds them as -
    // a file, bytes, an assembly it already has loaded. A host that
    // writes the cell out names the assembly `<name>.dll`: a compiler
    // records a reference under the referenced file's own name, so a
    // later cell's import only resolves when the two agree.
    class CELL_REQUEST(
        index: int,
        name: string,
        source: string,
        prelude_line_count: int,
        references: Collections.List[string],
        carried_line_count: int,
        carried_names: Collections.List[string]
    );

    // What the host got back. The diagnostics still carry the paths and
    // line numbers of the text that was compiled. A cell that compiled
    // arrives with its loaded form; one that did not arrives with none,
    // and the session is left as it was.
    class CELL_REPLY is
        diagnostics: Collections.List[CELL_DIAGNOSTIC]
        loaded: LOADED_CELL?

        init(diagnostics: Collections.List[CELL_DIAGNOSTIC], loaded: LOADED_CELL?) is
            self.diagnostics = diagnostics
            self.loaded = loaded
        si

        // For a host holding only the compiler's own lines, which are
        // taken apart here.
        init(lines: Collections.List[string], loaded: LOADED_CELL?) is
            let parsed = LIST[CELL_DIAGNOSTIC]()

            for line in lines do
                parsed.add(CELL_DIAGNOSTIC.parse(line))
            od

            diagnostics = parsed
            self.loaded = loaded
        si
    si

    // What a submission did. A cell that compiled is accepted whatever
    // its own code then does: its definitions exist and later cells can
    // use them, so running it is the host's business and happens after
    // this.
    class SUBMIT_OUTCOME(
        is_accepted: bool,
        diagnostics: Collections.List[string],
        cell: CELL?
    );

    // The session: the cells accepted so far, and what a new submission
    // does to them. It compiles nothing, loads nothing, runs nothing and
    // names no file, so a terminal, a notebook kernel and a browser page
    // each drive the same object over whatever compiles for them.
    //
    // Every cell is compiled after a prelude of imports: `use default`,
    // unless the session was made without it; one `use` per name an
    // earlier cell defined, naming the cell that last defined it; and the
    // `use` directives earlier cells opened with, so an import typed once
    // stays in force the way a definition does.
    class SESSION is
        _cells: LIST[CELL]

        // Each accepted cell's index and prelude length, by name, so a
        // diagnostic pointing into an earlier cell is shown where the
        // user wrote it.
        _spans: Collections.MAP[string, CELL_SPAN]
        _want_default_use: bool

        // One import per name, newest first: a later cell's definition
        // replaces an earlier import of the same name, and a later import
        // replaces an earlier definition, since two imports binding one
        // name are a duplicate even when they name different things.
        _bindings: Collections.MAP[string, string]

        // Imports that bring in a set of names rather than one.
        _wildcards: LIST[string]

        // The text of each type an accepted cell declared, by name, with
        // every partial and impl block later cells added to it: what a
        // cell extending the type declares again.
        _type_sources: Collections.MAP[string, LIST[string]]

        init() is
            self.init(true)
        si

        init(want_default_use: bool) is
            _next_index = 1
            _cells = LIST[CELL]()
            _spans = Collections.MAP[string, CELL_SPAN]()
            _want_default_use = want_default_use
            _bindings = Collections.MAP[string, string]()
            _wildcards = LIST[string]()
            _type_sources = Collections.MAP[string, LIST[string]]()
        si

        cells: Collections.List[CELL] => _cells

        // An import every cell gets until a cell defines the name itself,
        // for a name the host supplies rather than a cell, such as
        // display. A cell that defines the name replaces the import from
        // then on, as a definition replaces any earlier one.
        bind(name: string, directive: string) is
            _bindings[name] = directive
        si

        // Every name a new cell can see, and the cell that last defined
        // it. Later cells win, which is what makes a redefinition take
        // effect going forward without any lookup rule changing.
        visible_names() -> Collections.Map[string, CELL] is
            let result = Collections.MAP[string, CELL]()

            for cell in _cells do
                for name in cell.exports do
                    result[name] = cell
                od
            od

            return result
        si

        // The prelude for a cell that writes no imports of its own.
        prelude() -> string => prelude_for("")

        // The prelude for the given cell. An import the cell writes
        // itself is left out of it, and so is any other import binding
        // the same name, so the cell's own line is the one compiled and
        // its diagnostics point where the user wrote it. A name the cell
        // declares needs no exclusion: a declaration beats an import.
        prelude_for(source: string) -> string is
            let own = LIST[string](USE_DIRECTIVES.leading(source))
            let own_names = Collections.SET[string]()

            for directive in own do
                if let name = USE_DIRECTIVES.bound_name(directive) then
                    own_names.add(name)
                fi
            od

            let lines = LIST[string]()

            if _want_default_use /\ !own.contains("use default") then
                lines.add("use default")
            fi

            let bound = LIST[string]()

            for entry in _bindings do
                if !own_names.contains(entry.key) /\ !own.contains(entry.value) then
                    bound.add(entry.value)
                fi
            od

            bound.sort()
            lines.add_range(bound)

            for directive in _wildcards do
                if !own.contains(directive) /\ !lines.contains(directive) then
                    lines.add(directive)
                fi
            od

            if lines.count == 0 then
                return ""
            fi

            return "{lines |> Ghul.Pipes.join("\n")}\n"
        si

        // The number the next submission takes. Every submission takes
        // one, whether or not it compiles, so the numbers a user sees
        // count what they submitted; a cell that failed leaves its number
        // unused by any assembly.
        next_index: int => _next_index

        _next_index: int

        // What the next submission needs compiling. Calling this twice
        // without accepting in between describes the same cell twice:
        // nothing is recorded, and no number is spent, until the reply
        // comes back.
        //
        // A partial or impl block for a type an earlier cell declared
        // cannot reopen that cell's compiled type, so the type's own
        // text, with every block added to it since, is declared again in
        // this cell ahead of what the user wrote, and the block adds to
        // that. Later cells then see this cell's type.
        prepare(source: string) -> CELL_REQUEST is
            let index = _next_index
            let carried_names = carried_by(source)
            let carried = LIST[string]()

            let written = _extension_texts(source)

            for name in carried_names do
                for block in _type_sources[name] do
                    if !_replaced_by_any(block, written) then
                        carried.add(block)
                    fi
                od
            od

            let carried_text = if carried.count == 0 then "" else "{carried |> Ghul.Pipes.join("\n")}\n" fi
            let prelude_text = "{prelude_for(source)}{carried_text}"
            let prelude_line_count = if prelude_text.length == 0 then 0 else prelude_text.split(['\n']).count - 1 fi
            let carried_line_count = if carried_text.length == 0 then 0 else carried_text.split(['\n']).count - 1 fi

            let references = LIST[string]()

            for cell in _cells do
                references.add(cell.name)
            od

            return CELL_REQUEST(
                index,
                cell_name_for(index),
                "{prelude_text}{source}",
                prelude_line_count,
                references,
                carried_line_count,
                carried_names)
        si

        // The types an earlier cell declared that the source adds to
        // without declaring them itself.
        carried_by(source: string) -> Collections.List[string] is
            let declarations = DECLARATION_SPANS.of(source)
            let declared = Collections.SET[string]()

            for d in declarations do
                if !d.is_extension then
                    declared.add(d.name)
                fi
            od

            let result = LIST[string]()

            for d in declarations do
                if
                    d.is_extension /\ !declared.contains(d.name) /\
                    _type_sources.contains_key(d.name) /\ !result.contains(d.name)
                then
                    result.add(d.name)
                fi
            od

            return result
        si

        // Take the answer to a request. A cell that compiled joins the
        // session, and its names and its own imports are visible to
        // every later one; one that did not leaves the session exactly as
        // it was. The diagnostics come back naming each cell by its label
        // and with its generated prelude subtracted, so what they point
        // at is what the user wrote.
        accept(request: CELL_REQUEST, reply: CELL_REPLY) -> SUBMIT_OUTCOME is
            _next_index = System.Math.max(_next_index, request.index + 1)

            let diagnostics = LIST[string]()

            let spans = Collections.MAP[string, CELL_SPAN](_spans)

            let span = _span_for(request)

            spans[request.name] = span

            for diagnostic in reply.diagnostics do
                diagnostics.add(DIAGNOSTIC_LINES.for_display(diagnostic, spans).render())
            od

            if let loaded = reply.loaded then
                let cell = CELL(request.index, request.name, request.source, loaded.exports)

                _cells.add(cell)
                _spans[cell.name] = span

                _carry_imports(_user_text(request))
                _record_type_sources(_user_text(request), loaded.exports)

                for name in loaded.exports do
                    _bindings[name] = import_of(cell.name, name)
                od

                return SUBMIT_OUTCOME(true, diagnostics, cell)
            fi

            return SUBMIT_OUTCOME(false, diagnostics, null)
        si

        // Where a request's lines come from, for showing its diagnostics:
        // the generated prelude, then any carried definitions, which are
        // shown against the first block in the cell that adds to them.
        _span_for(request: CELL_REQUEST) -> CELL_SPAN is
            if request.carried_line_count == 0 then
                return CELL_SPAN(request.index, request.prelude_line_count)
            fi

            let user = _user_text(request)
            let anchor mut = 1

            for d in DECLARATION_SPANS.of(user) do
                if d.is_extension /\ _has(request.carried_names, d.name) then
                    anchor = _line_of(user, d.start)
                    break
                fi
            od

            return CELL_SPAN(
                request.index,
                request.prelude_line_count,
                request.carried_line_count,
                "the earlier definition of {request.carried_names |> Ghul.Pipes.join(" and ")}",
                anchor)
        si

        _record_type_sources(user: string, exports: Collections.List[string]) is
            let declarations = DECLARATION_SPANS.of(user)

            for d in declarations do
                if !d.is_extension /\ _has(exports, d.name) then
                    _type_sources[d.name] = LIST[string]([d.text_in(user)])
                fi
            od

            for d in declarations do
                if d.is_extension /\ _type_sources.contains_key(d.name) then
                    let block = d.text_in(user)
                    let sources = _type_sources[d.name]

                    // The type's own declaration comes first and is never
                    // replaced; a block after it can be.
                    let i mut = sources.count - 1

                    while i >= 1 do
                        if _replaces(block, sources[i]) then
                            sources.remove_at(i)
                        fi

                        i = i - 1
                    od

                    sources.add(block)
                fi
            od
        si

        _extension_texts(source: string) -> LIST[string] static is
            let result = LIST[string]()

            for d in DECLARATION_SPANS.of(source) do
                if d.is_extension then
                    result.add(d.text_in(source))
                fi
            od

            return result
        si

        _replaced_by_any(earlier: string, written: Collections.List[string]) -> bool static is
            for block in written do
                if _replaces(block, earlier) then
                    return true
                fi
            od

            return false
        si

        // Whether a block a cell writes replaces one an earlier cell added
        // to the same type, as a redefinition replaces a definition: an
        // impl of the same trait for the same type, or the same partial
        // block written again. Either added a second time would declare
        // its members twice.
        _replaces(written: string, earlier: string) -> bool static is
            let written_header = _impl_header(written)

            if written_header? then
                return written_header =~ _impl_header(earlier)
            fi

            return USE_DIRECTIVES.normalise(written) =~ USE_DIRECTIVES.normalise(earlier)
        si

        // `impl Trait for Type`, with its whitespace collapsed, or null for
        // any other block.
        _impl_header(block: string) -> string? static is
            let m = System.Text.RegularExpressions.Regex.match(
                block, "^\\s*(impl\\s.*?)\\s+is\\b", System.Text.RegularExpressions.RegexOptions.SINGLELINE)

            return if m.success then USE_DIRECTIVES.normalise(m.groups[1].value) else null fi
        si

        _has(names: Collections.List[string], name: string) -> bool static is
            for n in names do
                if n =~ name then
                    return true
                fi
            od

            return false
        si

        _line_of(text: string, offset: int) -> int static is
            let line mut = 1

            for i in 0..offset do
                if text[i] == '\n' then
                    line = line + 1
                fi
            od

            return line
        si

        // A diagnostic about a request's text that was analysed rather
        // than compiled, as the user is shown it: `path` is the file the
        // text was given under, and a location there is mapped past this
        // request's prelude and named by its label, as one in an earlier
        // cell is by that cell's. Null for a diagnostic about the
        // generated prelude, which the user did not write.
        for_request(request: CELL_REQUEST, path: string, diagnostic: CELL_DIAGNOSTIC) -> CELL_DIAGNOSTIC? is
            let file = IO.Path.get_file_name_without_extension(path) ?? path

            if let location = diagnostic.location then
                if (IO.Path.get_file_name_without_extension(location.path) ?? "") =~ file /\
                    location.start_line <= request.prelude_line_count
                then
                    return null
                fi
            fi

            let spans = Collections.MAP[string, CELL_SPAN](_spans)

            spans[file] = CELL_SPAN(request.index, request.prelude_line_count)

            return DIAGNOSTIC_LINES.for_display(diagnostic, spans)
        si

        // A generated import names what it imports escaped, so an
        // operator or a name that is also a keyword reads as a name.
        import_of(cell_name: string, name: string) -> string static => "use {cell_name}.`{name}"

        // Drops each generated import that a failed compile of the
        // request reports an error in, so a name that cannot be imported
        // costs the session that one name rather than every later cell.
        // Returns what was dropped; a caller that gets anything back
        // prepares the cell again.
        drop_failed_imports(
            request: CELL_REQUEST,
            diagnostics: Collections.List[CELL_DIAGNOSTIC]
        ) -> Collections.List[string] is
            let lines = request.source.split(['\n'])
            let dropped = LIST[string]()

            for diagnostic in diagnostics do
                let location = diagnostic.location

                if
                    location? /\ diagnostic.severity =~ "error" /\
                    (IO.Path.get_file_name_without_extension(location.path) ?? "") =~ request.name /\
                    location.start_line >= 1 /\ location.start_line <= request.prelude_line_count - request.carried_line_count
                then
                    let directive = lines[location.start_line - 1].trim()

                    if !dropped.contains(directive) /\ _drop_import(directive) then
                        dropped.add(directive)
                    fi
                fi
            od

            return dropped
        si

        _drop_import(directive: string) -> bool is
            let names = LIST[string]()

            for entry in _bindings do
                if entry.value =~ directive then
                    names.add(entry.key)
                fi
            od

            for name in names do
                _bindings.remove(name)
            od

            return _wildcards.remove(directive) \/ names.count > 0
        si

        _carry_imports(source: string) is
            for directive in USE_DIRECTIVES.leading(source) do
                if let name = USE_DIRECTIVES.bound_name(directive) then
                    _bindings[name] = directive
                elif !_wildcards.contains(directive) /\ !(_want_default_use /\ directive =~ "use default") then
                    _wildcards.add(directive)
                fi
            od
        si

        _user_text(request: CELL_REQUEST) -> string =>
            request.source.split(['\n']) |> Ghul.Pipes.skip(request.prelude_line_count) |> Ghul.Pipes.join("\n")
    si

    // What a cell's namespace is called, and the stem of any file a host
    // writes it to. Its index is enough: a session's cells never meet
    // another session's.
    cell_name_for(index: int) -> string => "{CELL_NAME_STEM}{index}"

    CELL_NAME_STEM: string => "cell"
si
