namespace Ghul.Cli.Tests is
    use Collections.LIST

    use Ghul.Cli.REPL_OPTIONS
    use Ghul.Repl.Host.COMPILE_RESULT
    use Ghul.Repl.Host.COMPILE_SERVER_REPLY
    use Ghul.Repl.Host.CompileBackend
    use Ghul.Repl.Host.SERVER_BACKEND
    use Ghul.Repl.Host.ServerConnection
    use Ghul.Repl.Host.SESSION_FILES
    use Ghul.Repl.Host.Completeness

    use Ghul.Repl.CELL_REQUEST

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // Answers with whatever it was given, in order, and records what it
    // was sent. A null answer is a server that did not reply in time.
    class FAKE_SERVER(_ready: string?, _replies: Collections.List[string?]): ServerConnection is
        sent: LIST[string]
        is_closed: bool public
        _next: int

        init(..) is
            sent = LIST[string]()
        si

        await_ready(timeout_ms: int) -> string? => _ready

        exchange(line: string, timeout_ms: int) -> string? is
            sent.add(line)

            if _next >= _replies.count then
                return null
            fi

            let reply = _replies[_next]

            _next = _next + 1

            return reply
        si

        close() is
            is_closed = true
        si
    si

    // Holds its one exchange until released, saying when it has begun.
    class BLOCKING_SERVER: ServerConnection is
        began: System.Threading.ManualResetEventSlim
        release: System.Threading.ManualResetEventSlim
        sent: LIST[string]
        is_closed: bool

        init() is
            began = System.Threading.ManualResetEventSlim(false)
            release = System.Threading.ManualResetEventSlim(false)
            sent = LIST[string]()
        si

        await_ready(timeout_ms: int) -> string? => "{{\"ready\":true,\"status\":0,\"diagnostics\":[]}}"

        exchange(line: string, timeout_ms: int) -> string? is
            sent.add(line)
            began.set()
            release.wait()

            if is_closed then
                return null
            fi

            return "{{\"status\":0,\"diagnostics\":[]}}"
        si

        // As a process ending does, closing ends an exchange under way.
        close() is
            is_closed = true
            release.set()
        si
    si

    class FAKE_BACKEND: CompileBackend is
        compiled: LIST[string]
        is_closed: bool public

        init() is
            compiled = LIST[string]()
        si

        compile(request: CELL_REQUEST) -> COMPILE_RESULT is
            compiled.add(request.name)

            return COMPILE_RESULT("spawned", LIST[Ghul.Repl.CELL_DIAGNOSTIC]())
        si

        close() is
            is_closed = true
        si
    si

    @TestClass()
    class SERVER_BACKEND_TESTS is
        init() is si

        _ready: string => "{{\"ready\":true,\"status\":0,\"diagnostics\":[]}}"

        _no_reply() -> LIST[string?] is
            let replies = LIST[string?]()

            replies.add(null)

            return replies
        si

        _files() -> SESSION_FILES =>
            SESSION_FILES(IO.Path.join([IO.Path.get_temp_path(), "ghul-cli-tests-{System.Guid.new_guid().to_string("N")}"]), null)

        _request(index: int) -> CELL_REQUEST =>
            CELL_REQUEST(index, "cell{index}", "let x = 1\n", 0, LIST[string](), 0, LIST[string]())

        _backend(server: ServerConnection?, fallback: CompileBackend, said: LIST[string]) -> SERVER_BACKEND =>
            SERVER_BACKEND(server, fallback, _files(), line => said.add(line))

        @Test()
        warm_up__compiles_a_throwaway_cell_on_the_server() is
            let server = FAKE_SERVER(_ready, LIST[string?](["{{\"status\":0,\"diagnostics\":[]}}", "{{\"status\":0,\"diagnostics\":[]}}"]))
            let backend = _backend(server, FAKE_BACKEND(), LIST[string]())

            backend.warm_up().wait()

            let request = System.Text.Json.JsonDocument.parse(server.sent[0], _).root_element

            assert request.get_property("name").get_string() =~ SERVER_BACKEND.WARM_UP_NAME;

            let result = backend.compile(_request(1))

            assert result.assembly_path!.ends_with("cell1.dll");
            assert server.sent.count == 2;
        si

        // Typing at the prompt while the warm-up has the server asks the
        // fallback rather than waiting for the server.
        @Test()
        check__leaves_the_answer_to_the_fallback_while_the_warm_up_runs() is
            let server = BLOCKING_SERVER()
            let backend = _backend(server, FAKE_BACKEND(), LIST[string]())

            let warming = backend.warm_up()

            assert server.began.wait(10000);
            assert !backend.check("1 + 1")?;

            server.release.set()

            assert warming.wait(10000);
            assert server.sent.count == 1;
        si

        @Test()
        close__ends_a_warm_up_under_way_without_reporting_it() is
            let server = BLOCKING_SERVER()
            let said = LIST[string]()
            let backend = _backend(server, FAKE_BACKEND(), said)

            let warming = backend.warm_up()

            assert server.began.wait(10000);

            backend.close()

            assert warming.wait(10000);
            assert server.is_closed;
            assert said.count == 0;
            assert !backend.is_serving;
        si

        @Test()
        compile__compiles_on_the_server_once_it_is_ready() is
            let server = FAKE_SERVER(_ready, LIST[string?](["{{\"status\":0,\"diagnostics\":[]}}"]))
            let fallback = FAKE_BACKEND()
            let said = LIST[string]()

            let result = _backend(server, fallback, said).compile(_request(1))

            assert result.assembly_path?;
            assert result.assembly_path!.ends_with("cell1.dll");
            assert fallback.compiled.count == 0;
            assert said.count == 0;
            assert server.sent.count == 1;
        si

        // The request names the cell, carries its text, and names each
        // earlier cell by where its assembly is.
        @Test()
        compile__sends_the_cell_and_its_references() is
            let server = FAKE_SERVER(_ready, LIST[string?](["{{\"status\":0,\"diagnostics\":[]}}"]))
            let backend = _backend(server, FAKE_BACKEND(), LIST[string]())

            backend.compile(CELL_REQUEST(2, "cell2", "x\n", 0, LIST[string](["cell1"]), 0, LIST[string]()));

            let request = System.Text.Json.JsonDocument.parse(server.sent[0], _).root_element

            assert request.get_property("name").get_string() =~ "cell2";
            assert request.get_property("text").get_string() =~ "x\n";
            assert request.get_property("output").get_string()!.ends_with("cell2.dll");
            assert request.get_property("references")[0].get_string()!.ends_with("cell1.dll");
        si

        // Source the compiler rejects is the cell's problem, not the
        // server's, so the server keeps the session.
        @Test()
        compile__reports_a_cell_with_errors_as_the_cells() is
            let server =
                FAKE_SERVER(
                    _ready,
                    LIST[string?]([
                        "{{\"status\":1,\"diagnostics\":[{{\"start_line\":1,\"start_column\":9,\"end_line\":1,\"end_column\":16,\"severity\":1,\"message\":\"symbol not found: y\",\"code\":\"\"}}]}}",
                        "{{\"status\":0,\"diagnostics\":[]}}"
                    ]))

            let fallback = FAKE_BACKEND()
            let backend = _backend(server, fallback, LIST[string]())

            let result = backend.compile(_request(1))

            assert !result.assembly_path?;
            assert result.diagnostics[0].render() =~ "cell1.ghul: 1,9..1,16: error: symbol not found: y";

            backend.compile(_request(2));

            assert fallback.compiled.count == 0;
            assert server.sent.count == 2;
        si

        @Test()
        compile__treats_an_internal_error_as_the_cells() is
            let server =
                FAKE_SERVER(
                    _ready,
                    LIST[string?](["{{\"status\":2,\"message\":\"internal error\",\"diagnostics\":[]}}"]))

            let fallback = FAKE_BACKEND()
            let said = LIST[string]()

            let result = _backend(server, fallback, said).compile(_request(1))

            assert !result.assembly_path?;
            assert fallback.compiled.count == 0;
            assert said.count == 0;
        si

        @Test()
        compile__falls_back_when_the_server_does_not_start() is
            let fallback = FAKE_BACKEND()
            let said = LIST[string]()
            let backend = _backend(null, fallback, said)

            assert backend.compile(_request(1)).assembly_path =~ "spawned";
            assert fallback.compiled.count == 1;
            assert said.count == 1;
        si

        @Test()
        compile__falls_back_when_the_server_never_says_it_is_ready() is
            let server = FAKE_SERVER(null, LIST[string?]())
            let fallback = FAKE_BACKEND()
            let said = LIST[string]()

            _backend(server, fallback, said).compile(_request(1));

            assert fallback.compiled.count == 1;
            assert server.is_closed;
            assert said.count == 1;
        si

        // Once it has given up on the server it says so once and asks it
        // nothing more.
        @Test()
        compile__falls_back_for_good_when_the_server_stops_answering() is
            let server = FAKE_SERVER(_ready, _no_reply())
            let fallback = FAKE_BACKEND()
            let said = LIST[string]()
            let backend = _backend(server, fallback, said)

            backend.compile(_request(1));
            backend.compile(_request(2));

            assert fallback.compiled.count == 2;
            assert server.sent.count == 1;
            assert server.is_closed;
            assert said.count == 1;
            assert !backend.is_serving;
        si

        @Test()
        compile__falls_back_when_the_server_refuses_a_request() is
            let server =
                FAKE_SERVER(
                    _ready,
                    LIST[string?](["{{\"status\":2,\"message\":\"reference not found: x\",\"diagnostics\":[]}}"]))

            let fallback = FAKE_BACKEND()
            let said = LIST[string]()

            _backend(server, fallback, said).compile(_request(1));

            assert fallback.compiled.count == 1;
            assert said[0].contains("reference not found: x");
        si

        @Test()
        compile__falls_back_when_the_reply_is_not_one() is
            let server = FAKE_SERVER(_ready, LIST[string?](["not json"]))
            let fallback = FAKE_BACKEND()

            _backend(server, fallback, LIST[string]()).compile(_request(1));

            assert fallback.compiled.count == 1;
        si

        @Test()
        check__asks_the_server_once_it_is_ready() is
            let server = FAKE_SERVER(_ready, LIST[string?](["{{\"status\":0,\"completeness\":\"incomplete\",\"diagnostics\":[]}}"]))
            let backend = _backend(server, FAKE_BACKEND(), LIST[string]())

            assert backend.check("if x then\n") =~ Completeness.INCOMPLETE;

            let request = System.Text.Json.JsonDocument.parse(server.sent[0], _).root_element

            assert request.get_property("check").get_boolean();
            assert request.get_property("text").get_string() =~ "if x then\n";
        si

        @Test()
        check__reads_each_answer() is
            let server =
                FAKE_SERVER(
                    _ready,
                    LIST[string?]([
                        "{{\"status\":0,\"completeness\":\"complete\",\"diagnostics\":[]}}",
                        "{{\"status\":0,\"completeness\":\"invalid\",\"diagnostics\":[]}}"
                    ]))

            let backend = _backend(server, FAKE_BACKEND(), LIST[string]())

            assert backend.check("x\n") =~ Completeness.COMPLETE;
            assert backend.check("let = 3\n") =~ Completeness.INVALID;
        si

        // The first line typed does not wait for the server to warm up,
        // and a server still warming up has not failed.
        @Test()
        check__leaves_it_to_the_fallback_until_the_server_is_ready() is
            let server = FAKE_SERVER(null, LIST[string?]())
            let said = LIST[string]()
            let backend = _backend(server, FAKE_BACKEND(), said)

            assert !backend.check("x\n")?;
            assert server.sent.count == 0;
            assert !server.is_closed;
            assert said.count == 0;
        si

        @Test()
        check__leaves_it_to_the_fallback_with_no_server() is
            assert !_backend(null, FAKE_BACKEND(), LIST[string]()).check("x\n")?;
        si

        @Test()
        check__gives_up_on_a_server_that_stops_answering() is
            let server = FAKE_SERVER(_ready, _no_reply())
            let fallback = FAKE_BACKEND()
            let said = LIST[string]()
            let backend = _backend(server, fallback, said)

            assert !backend.check("x\n")?;
            assert server.is_closed;
            assert said.count == 1;

            backend.compile(_request(1));

            assert fallback.compiled.count == 1;
        si

        // A backend written elsewhere need not answer: the default leaves
        // the check to the session.
        @Test()
        check__defaults_to_no_answer_for_a_backend_written_elsewhere() is
            let backend: CompileBackend = FAKE_BACKEND()

            assert !backend.check("x\n")?;
        si

        @Test()
        close__closes_the_server_and_the_fallback() is
            let server = FAKE_SERVER(_ready, LIST[string?]())
            let fallback = FAKE_BACKEND()

            _backend(server, fallback, LIST[string]()).close();

            assert server.is_closed;
            assert fallback.is_closed;
        si
    si

    @TestClass()
    class COMPILE_SERVER_REPLY_TESTS is
        init() is si

        @Test()
        parse__writes_a_warning_as_a_batch_compile_does() is
            let reply =
                COMPILE_SERVER_REPLY.parse(
                    "{{\"status\":0,\"diagnostics\":[{{\"start_line\":2,\"start_column\":5,\"end_line\":2,\"end_column\":8,\"severity\":2,\"message\":\"non-snake_case name 'Bad'\",\"code\":\"non-snake-case-name\"}}]}}",
                    "cell3.ghul")

            assert reply?;
            assert reply.diagnostics[0].render() =~ "cell3.ghul: 2,5..2,8: warn: [non-snake-case-name] non-snake_case name 'Bad'";
        si

        @Test()
        parse__is_null_for_a_line_that_is_not_a_reply() is
            assert !COMPILE_SERVER_REPLY.parse("{{\"ready\":true}}", "cell1.ghul")?;
            assert !COMPILE_SERVER_REPLY.parse("nonsense", "cell1.ghul")?;
        si
    si

    @TestClass()
    class REPL_OPTIONS_TESTS is
        init() is si

        @Test()
        parse__defaults_to_the_server_and_the_default_imports() is
            let options = REPL_OPTIONS.parse(LIST[string]())

            assert options?;
            assert options.want_server;
            assert options.want_default_use;
        si

        @Test()
        parse__takes_both_flags() is
            let options = REPL_OPTIONS.parse(LIST[string](["--no-server", "--no-default-use"]))

            assert options?;
            assert !options.want_server;
            assert !options.want_default_use;
        si

        @Test()
        parse__is_null_for_an_argument_it_does_not_take() is
            assert !REPL_OPTIONS.parse(LIST[string](["--fast"]))?;
        si

        @Test()
        parse__defaults_to_choosing_the_theme_from_the_terminal() is
            assert REPL_OPTIONS.parse(LIST[string]())!.theme == Ghul.Cli.Repl.ThemeChoice.AUTO;
        si

        @Test()
        parse__takes_a_theme() is
            assert REPL_OPTIONS.parse(LIST[string](["--theme", "light"]))!.theme == Ghul.Cli.Repl.ThemeChoice.LIGHT;
            assert REPL_OPTIONS.parse(LIST[string](["--theme", "dark", "--no-server"]))!.theme == Ghul.Cli.Repl.ThemeChoice.DARK;
            assert REPL_OPTIONS.parse(LIST[string](["--theme", "none"]))!.theme == Ghul.Cli.Repl.ThemeChoice.NONE;
        si

        @Test()
        parse__is_null_for_a_theme_it_does_not_know_or_a_missing_one() is
            assert !REPL_OPTIONS.parse(LIST[string](["--theme", "solarized"]))?;
            assert !REPL_OPTIONS.parse(LIST[string](["--theme"]))?;
        si
    si
si
