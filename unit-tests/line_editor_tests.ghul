namespace Ghul.Cli.Tests is
    use Collections.LIST

    use Ghul.Cli.Repl.CELL_BUFFER
    use Ghul.Cli.Repl.HISTORY_STORE
    use Ghul.Cli.Repl.LINE_HISTORY

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    @TestClass()
    class CELL_BUFFER_LINE_EDITING_TESTS is
        init() is si

        _typed(text: string) -> CELL_BUFFER is
            let buffer = CELL_BUFFER()

            buffer.insert(text)

            return buffer
        si

        @Test()
        insert__writes_at_the_cursor() is
            let buffer = _typed("lt x")

            buffer.home()
            buffer.right()
            buffer.insert("e")

            assert buffer.text =~ "let x";
            assert buffer.column == 2;
        si

        @Test()
        backspace_and_delete__remove_either_side_of_the_cursor() is
            let buffer = _typed("abcd")

            buffer.left()
            buffer.left()
            buffer.backspace()
            buffer.delete()

            assert buffer.text =~ "ad";
            assert buffer.column == 1;
        si

        // In the spaces a line starts with, backspace goes back a whole
        // indent step.
        @Test()
        backspace__removes_an_indent_step_in_leading_spaces() is
            let buffer = _typed("      ")

            buffer.backspace()

            assert buffer.text =~ "    ";
            assert buffer.column == 4;

            buffer.backspace()

            assert buffer.text =~ "";
        si

        @Test()
        backspace__removes_one_character_after_the_leading_spaces() is
            let buffer = _typed("    ab")

            buffer.backspace()

            assert buffer.text =~ "    a";
        si

        @Test()
        insert__outdents_a_closing_word_on_a_line_enter_indented() is
            let buffer = _typed("if x then")

            buffer.new_line()
            buffer.insert("fi")

            assert buffer.line =~ "fi";
            assert buffer.column == 2;
        si

        @Test()
        moving__stops_at_either_end() is
            let buffer = _typed("ab")

            buffer.right()
            assert buffer.column == 2;

            buffer.home()
            buffer.left()
            buffer.backspace()
            assert buffer.column == 0;
            assert buffer.text =~ "ab";

            buffer.end()
            buffer.delete()
            assert buffer.text =~ "ab";
        si

        @Test()
        name_before_cursor__is_the_part_of_a_name_being_typed() is
            assert _typed("let y = ans").name_before_cursor =~ "ans";
            assert _typed("x.").name_before_cursor =~ "";
            assert _typed("f(a_b1").name_before_cursor =~ "a_b1";
        si

        @Test()
        extension__is_the_rest_of_the_only_name() is
            assert CELL_BUFFER.extension("ans", LIST[string](["answer"])) =~ "wer";
        si

        @Test()
        extension__is_as_far_as_the_names_agree() is
            assert CELL_BUFFER.extension("va", LIST[string](["value1", "value2", "values"])) =~ "lue";
            assert CELL_BUFFER.extension("x", LIST[string](["xa", "xb"])) =~ "";
            assert CELL_BUFFER.extension("x", LIST[string]()) =~ "";
        si
    si

    @TestClass()
    class LINE_HISTORY_TESTS is
        init() is si

        @Test()
        previous_and_next__walk_the_lines_entered() is
            let history = LINE_HISTORY()

            history.add("one")
            history.add("two")

            assert history.previous() =~ "two";
            assert history.previous() =~ "one";
            assert !history.previous()?;
            assert history.next() =~ "two";
            assert history.next() =~ "";
            assert !history.next()?;
        si

        @Test()
        add__keeps_no_blank_line_or_immediate_repeat() is
            let history = LINE_HISTORY()

            history.add("one")
            history.add("  ")
            history.add("one")

            assert history.previous() =~ "one";
            assert !history.previous()?;
        si
    si

    @TestClass()
    class HISTORY_STORE_TESTS is
        init() is si

        _path() -> string => IO.Path.combine(IO.Path.get_temp_path(), "ghul-cli-history-{System.Guid.new_guid()}", "history")

        @Test()
        encode_and_decode__round_trip_line_breaks_and_backslashes() is
            let cell = "if x then\n    \"a\\n\"\nfi"
            let encoded = HISTORY_STORE.encode(cell)

            assert !encoded.contains('\n');
            assert HISTORY_STORE.decode(encoded) =~ cell;
        si

        @Test()
        append_and_load__carry_cells_to_a_later_session() is
            let path = _path()

            try
                let first = LINE_HISTORY(HISTORY_STORE(path, 10))

                first.add("let a = 1")
                first.add("if a > 0 then\n    a\nfi")

                let later = LINE_HISTORY(HISTORY_STORE(path, 10))

                assert later.previous() =~ "if a > 0 then\n    a\nfi";
                assert later.previous() =~ "let a = 1";
                assert !later.previous()?;
            finally
                IO.Directory.delete(IO.Path.get_directory_name(path)!, true)
            yrt
        si

        @Test()
        load__keeps_the_newest_cells_up_to_the_limit() is
            let path = _path()

            try
                let store = HISTORY_STORE(path, 3)

                for i in 0..7 do
                    store.append("cell {i}")
                od

                let cells = HISTORY_STORE(path, 3).load()

                assert cells.count == 3;
                assert cells[0] =~ "cell 4";
                assert cells[2] =~ "cell 6";
                assert IO.File.read_all_lines(path).count == 3;
            finally
                IO.Directory.delete(IO.Path.get_directory_name(path)!, true)
            yrt
        si

        @Test()
        load__is_empty_without_a_file() is
            assert HISTORY_STORE(_path(), 3).load().count == 0;
        si
    si
si
