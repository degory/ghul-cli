namespace Ghul.Cli.Tests is
    use Collections.LIST

    use Ghul.Cli.Repl.SUBMISSION_END

    use Ghul.Repl.CELL_REPLY
    use Ghul.Repl.CELL_REQUEST
    use Ghul.Repl.DIAGNOSTIC_LINES
    use Ghul.Repl.LOADED_CELL
    use Ghul.Repl.SESSION

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    @TestClass()
    class REPL_SESSION_TESTS is
        init() is si

        _no_diagnostics() -> Collections.List[string] => LIST[string]()

        // A cell that compiled, exporting the given names.
        _compiled(names: Collections.List[string]) -> CELL_REPLY =>
            CELL_REPLY(_no_diagnostics(), LOADED_CELL(names, null))

        _accept(session: SESSION, source: string, names: Collections.List[string]) -> CELL_REQUEST is
            let request = session.prepare(source)

            session.accept(request, _compiled(names));

            return request
        si

        @Test()
        prelude__is_empty_for_the_first_cell() is
            assert SESSION().prelude() =~ "";
        si

        @Test()
        prepare__names_each_cell_after_its_position_in_the_session() is
            let session = SESSION()

            assert session.prepare("let x = 1\n").name =~ "cell1";

            _accept(session, "let x = 1\n", LIST[string](["x"]));

            assert session.prepare("let y = 2\n").name =~ "cell2";
        si

        @Test()
        prelude__imports_every_name_an_accepted_cell_exported() is
            let session = SESSION()

            _accept(session, "let x = 1\n", LIST[string](["x", "inc"]));

            assert session.prelude() =~ "use cell1.inc\nuse cell1.x\n";
        si

        // The newest definer wins, which is what makes a redefinition
        // take effect for every later cell.
        @Test()
        prelude__names_the_newest_cell_that_defined_each_name() is
            let session = SESSION()

            _accept(session, "let x = 1\n", LIST[string](["x", "inc"]));
            _accept(session, "let x = 2\n", LIST[string](["x"]));

            assert session.prelude() =~ "use cell1.inc\nuse cell2.x\n";
        si

        @Test()
        prepare__prepends_the_prelude_to_what_the_user_wrote() is
            let session = SESSION()

            _accept(session, "let x = 1\n", LIST[string](["x"]));

            assert session.prepare("write_line(x)\n").source =~ "use cell1.x\nwrite_line(x)\n";
        si

        // How far the diagnostics have to move back to name the lines
        // the user wrote rather than the ones the session generated.
        @Test()
        prepare__counts_the_prelude_lines_it_generated() is
            let session = SESSION()

            assert session.prepare("let x = 1\n").prelude_line_count == 0;

            _accept(session, "let x = 1\n", LIST[string](["x", "inc"]));

            assert session.prepare("write_line(x)\n").prelude_line_count == 2;
        si

        @Test()
        prepare__names_the_earlier_cells_a_submission_references() is
            let session = SESSION()

            _accept(session, "let x = 1\n", LIST[string](["x"]));
            _accept(session, "let y = 2\n", LIST[string](["y"]));

            let references = session.prepare("write_line(x)\n").references

            assert references.count == 2;
            assert references[0] =~ "cell1";
            assert references[1] =~ "cell2";
        si

        // A cell that did not compile is not part of the session: it
        // exports nothing and nothing later can import from it.
        @Test()
        accept__leaves_no_trace_of_a_cell_that_failed_to_compile() is
            let session = SESSION()
            let request = session.prepare("let x = 1\n")

            let outcome =
                session.accept(
                    request,
                    CELL_REPLY(LIST[string](["cell1.ghul: 1,1..1,2: error: no"]), null))

            assert !outcome.is_accepted;
            assert !outcome.cell?;
            assert session.cells.count == 0;
            assert session.prelude() =~ "";
        si

        @Test()
        accept__keeps_a_cell_that_compiled() is
            let session = SESSION()
            let request = session.prepare("let x = 1\n")

            let outcome = session.accept(request, _compiled(LIST[string](["x"])))

            assert outcome.is_accepted;
            assert session.cells.count == 1;

            if let cell = outcome.cell then
                assert cell.name =~ "cell1";
                assert cell.source =~ "let x = 1\n";
            else
                assert false else "the accepted cell should have come back";
            fi
        si

        // The line numbers a front end shows are the user's own, so the
        // generated prelude comes back off them here.
        @Test()
        accept__moves_the_diagnostics_back_past_the_prelude() is
            let session = SESSION()

            _accept(session, "let x = 1\n", LIST[string](["x", "inc"]));

            let request = session.prepare("write_line(y)\n")

            let outcome =
                session.accept(
                    request,
                    CELL_REPLY(LIST[string](["cell2.ghul: 3,12..3,13: error: symbol not found: y"]), null))

            assert outcome.diagnostics[0] =~ "cell2.ghul: 1,12..1,13: error: symbol not found: y";
        si
    si

    @TestClass()
    class REPL_DIAGNOSTIC_TESTS is
        init() is si

        // The user's line 1 is the file's line 3 when two lines of
        // prelude went in front of it.
        @Test()
        strip_prelude__moves_a_diagnostic_back_past_the_prelude() is
            let mapped = DIAGNOSTIC_LINES.strip_prelude("cell2.ghul: 4,5..4,9: error: symbol not found: y", 2);

            assert mapped =~ "cell2.ghul: 2,5..2,9: error: symbol not found: y";
        si

        // A diagnostic about the generated lines themselves is left
        // alone: the user did not write them and cannot fix them.
        @Test()
        strip_prelude__leaves_a_diagnostic_in_the_prelude_alone() is
            let line = "cell2.ghul: 1,5..1,9: error: symbol not found: y"

            assert DIAGNOSTIC_LINES.strip_prelude(line, 2) =~ line;
        si

        @Test()
        strip_prelude__leaves_a_line_alone_when_there_is_no_prelude() is
            let line = "cell1.ghul: 3,5..3,9: error: symbol not found: y"

            assert DIAGNOSTIC_LINES.strip_prelude(line, 0) =~ line;
        si

        @Test()
        strip_prelude__leaves_a_line_it_cannot_read_alone() is
            let line = "ghul: failed to start the compiler"

            assert DIAGNOSTIC_LINES.strip_prelude(line, 2) =~ line;
        si
    si

    @TestClass()
    class REPL_SUBMISSION_END_TESTS is
        init() is si

        @Test()
        is_complete__is_true_for_a_blank_line_after_something() is
            assert SUBMISSION_END.is_complete(LIST[string](["let x = 1"]), "");
        si

        @Test()
        is_complete__is_false_for_a_blank_line_with_nothing_typed() is
            assert !SUBMISSION_END.is_complete(LIST[string](), "");
        si

        @Test()
        is_complete__is_false_for_a_line_with_content() is
            assert !SUBMISSION_END.is_complete(LIST[string](["let x = 1"]), "let y = 2");
        si
    si
si
