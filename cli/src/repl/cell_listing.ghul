namespace Ghul.Cli.Repl is
    use Collections.LIST
    use Ghul.Repl.CellStatus
    use Ghul.Repl.NOTEBOOK
    use Ghul.Repl.NOTEBOOK_CELL

    // What `:cells` shows: the notebook's cells in order, or one of them.
    class CELL_LISTING is
        init() is si

        // The last `limit` cells, in order: each one's number, how its
        // latest run ended, its first line, how many lines it has when it
        // has more than one, and whether it has been edited or has fallen
        // out of date since it ran.
        summary(notebook: NOTEBOOK, limit: int) -> LIST[string] static is
            let lines = LIST[string]()
            let cells = notebook.cells

            if cells.count == 0 then
                lines.add("no cells yet")

                return lines
            fi

            let first = System.Math.max(0, cells.count - limit)

            if first > 0 then
                lines.add("{first} earlier cells not shown")
            fi

            let width mut = 1

            for cell in cells do
                width = System.Math.max(width, _number_of(cell).length)
            od

            for i in first..cells.count do
                let cell = cells[i]
                let source_lines = _lines_of(cell.source)
                let more = if source_lines.count > 1 then "  ({source_lines.count} lines)" else "" fi
                let notes = _notes(notebook, cell)

                lines.add("{_number_of(cell).pad_left(width)}  {_status_of(cell).pad_right(11)} {source_lines[0].trim_end()}{more}{notes}")
            od

            return lines
        si

        // The whole of the cell that ran as `number`, now or before,
        // under a line saying how its latest run ended.
        cell(notebook: NOTEBOOK, number: string) -> LIST[string] static is
            let lines = LIST[string]()
            let wanted mut = 0

            if !int.try_parse(number, wanted ref) then
                lines.add("usage: :cells N")

                return lines
            fi

            if let cell = notebook.with_number(wanted) then
                lines.add("cell {_number_of(cell)}: {_status_of(cell)}{_notes(notebook, cell)}")
                lines.add_range(_lines_of(cell.source))

                return lines
            fi

            lines.add("no cell {wanted}")

            return lines
        si

        status_name(status: CellStatus) -> string static =>
            case status
            when CellStatus.OK then "ok"
            when CellStatus.FAILED then "failed"
            when CellStatus.THREW then "threw"
            when CellStatus.INTERRUPTED then "interrupted"
            esac

        _number_of(cell: NOTEBOOK_CELL) -> string static =>
            if let number = cell.number then "{number}" else "-" fi

        _status_of(cell: NOTEBOOK_CELL) -> string static =>
            if let run = cell.last_run then status_name(run.status) else "not run" fi

        _notes(notebook: NOTEBOOK, cell: NOTEBOOK_CELL) -> string static is
            let notes = LIST[string]()

            if cell.last_run? /\ cell.is_edited then
                notes.add("edited")
            fi

            if notebook.is_out_of_date(cell) then
                notes.add("out of date")
            fi

            if cell.numbers.count > 1 then
                notes.add("was {cell.numbers |> Ghul.Pipes.take(cell.numbers.count - 1) |> Ghul.Pipes.join(", ")}")
            fi

            return if notes.count == 0 then "" else "  ({notes |> Ghul.Pipes.join("; ")})" fi
        si

        _lines_of(source: string) -> LIST[string] static is
            let lines = LIST[string](source.trim_end(['\n']).split(['\n']))

            if lines.count == 0 then
                lines.add("")
            fi

            return lines
        si
    si
si
