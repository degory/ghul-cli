namespace Ghul.Cli.Repl is
    use Collections.LIST
    use IO.Std

    // A cell read at the prompt: its source and what submitting it does. A
    // command is a cell of one line starting with `:`, handed back as it
    // was typed.
    class CELL_READ(source: string, step: CellStep, is_command: bool);

    // A cell edited in place at the terminal, all of it at once. Up and
    // Down move between its lines, and past the first or last line recall
    // earlier cells; Left and Right cross line ends; Enter inserts a line
    // in the middle of the cell and on its last line does what CELL_END
    // says; Alt-Enter submits the cell from any line. Backspace at the
    // start of a line joins it to the one above, and Delete at the end of
    // one joins the next. Home and End (or Ctrl-A and Ctrl-E) go to either
    // end of a line, Ctrl-Left and Ctrl-Right (or Alt-B and Alt-F) move by
    // a word, Ctrl-U and Ctrl-K delete to either end of the line, Ctrl-W
    // deletes the word before the cursor, Ctrl-L clears the screen, Tab
    // completes and then offers a menu, Shift-Tab shows what the name at
    // the cursor is, a paste is taken as it is, and Ctrl-D in an empty
    // cell ends the input.
    // Ctrl-C abandons the cell to history and starts it again.
    class CELL_EDITOR(
        _complete: (string, int, int) -> Collections.List[string]?,
        _hover: (string, int, int) -> string?,
        _palette: PALETTE?,
        _end: CELL_END
    ) is
        _history: LINE_HISTORY
        _buffer: CELL_BUFFER

        // The cell being typed when Up first went into history, put back
        // when Down comes out past the newest entry.
        _draft: CELL_SNAPSHOT?

        // How many screen rows down from the first drawn row the cursor
        // is, so the next redraw can go back up to the start.
        _cursor_screen_row: int

        // The first line drawn, when the cell is taller than the terminal.
        _top: int

        // The names Tab offers, while they are shown to choose from.
        _menu: COMPLETION_MENU?

        init(..) is
            _prompt = "> "
            _continuation = "| "
            _history = LINE_HISTORY(HISTORY_STORE(HISTORY_STORE.default_path(), 1000))
            _buffer = CELL_BUFFER()

            // Pasted text arrives between markers, so it can be told apart
            // from typing.
            Std.write("{_escape}[?2004h")
        si

        _escape: char static => cast char(27)

        // Leaves the terminal as it was found.
        close() is
            Std.write("{_escape}[?2004l")
        si

        // The next cell, or null when the input has ended.
        // The prompt for a cell's first line, and for the lines after it,
        // aligned so the code starts in the same column on both.
        _prompt: string
        _continuation: string

        // The next cell, numbered `number` at its prompt, or null when the
        // input has ended.
        read_cell(number: int) -> CELL_READ? => read_cell(number, null)

        // As read_cell(number), starting from `text` rather than an empty
        // cell: an earlier cell brought back to edit.
        read_cell(number: int, text: string?) -> CELL_READ? is
            _prompt = "{number}> "
            _continuation = "{string(' ', _prompt.length - 2)}| "
            _initial = text

            return read_cell()
        si

        _initial: string?

        read_cell() -> CELL_READ? is
            // Ctrl-C is read as a key while a cell is edited, rather than
            // ending the process.
            let was_control_c_input = Std.treat_control_c_as_input

            Std.treat_control_c_as_input = true

            try
                return _read_cell()
            finally
                Std.treat_control_c_as_input = was_control_c_input
            yrt
        si

        _read_cell() -> CELL_READ? is
            _buffer.clear()

            if let text = _initial then
                _buffer.replace(text.trim_end(['\n']))
                _initial = null
            fi

            _end.clear()
            _draft = null
            _menu = null

            _cursor_screen_row = 0
            _top = 0

            _draw()

            do
                let key = Std.read_key(true)
                let modifiers = key.modifiers
                let is_control = (modifiers & System.ConsoleModifiers.CONTROL) == System.ConsoleModifiers.CONTROL
                let is_alt = (modifiers & System.ConsoleModifiers.ALT) == System.ConsoleModifiers.ALT

                if is_control /\ key.key == System.ConsoleKey.C then
                    _abandon()

                    continue
                fi

                if let menu = _menu then
                    if _menu_key(menu, key, is_alt) then
                        continue
                    fi
                fi

                // A terminal sends Alt-Enter as Escape then Enter, and a
                // paste between Escape-led markers.
                if key.key == System.ConsoleKey.ESCAPE /\ _key_arrives_soon() then
                    let next = Std.read_key(true)

                    if next.key == System.ConsoleKey.ENTER then
                        if let read = _submit_now() then
                            return read
                        fi
                    elif next.key_char == 'b' then
                        _buffer.word_left()
                    elif next.key_char == 'f' then
                        _buffer.word_right()
                    elif next.key_char == '[' /\ _follows("200~") then
                        _buffer.insert_verbatim(_read_paste())
                    fi

                    _draw()

                    continue
                fi

                case key.key
                when System.ConsoleKey.ENTER then
                    if is_alt then
                        if let read = _submit_now() then
                            return read
                        fi
                    elif let continued = CONTINUATION.strip(_buffer.line) then
                        // A lone backslash at the end of a line opens the
                        // next one, whatever the cell would otherwise do.
                        _buffer.replace_line(continued)
                        _buffer.new_line()
                    else
                        // Blank lines after the cursor's are no reason to treat
                        // Enter as adding a line in the middle of the cell.
                        if _buffer.is_on_last_written_line then
                            _buffer.drop_blank_lines_below()
                        fi

                        if !_buffer.is_on_last_line then
                            _buffer.new_line()
                        else
                            let lines = _buffer.lines
                            let step = _end.step_for(lines)

                            if step == CellStep.WAIT then
                                _buffer.add_line()
                            else
                                let is_command = lines.count == 1 /\ lines[0].trim().starts_with(":")
                                let source = if is_command then lines[0] else _end.source_for(lines) fi

                                _buffer.to_end()
                                _finish("")

                                if step != CellStep.NOTHING then
                                    _history.add(CELL_TEXT.without_terminator(_buffer.lines))
                                fi

                                return CELL_READ(source, step, is_command)
                            fi
                        fi
                    fi
                when System.ConsoleKey.BACKSPACE then
                    _buffer.backspace()
                when System.ConsoleKey.DELETE then
                    _buffer.delete()
                when System.ConsoleKey.LEFT_ARROW then
                    if is_control then _buffer.word_left() else _buffer.left() fi
                when System.ConsoleKey.RIGHT_ARROW then
                    if is_control then _buffer.word_right() else _buffer.right() fi
                when System.ConsoleKey.HOME then
                    _buffer.home()
                when System.ConsoleKey.END then
                    _buffer.end()
                when System.ConsoleKey.UP_ARROW then
                    if !_buffer.up() then
                        let draft = if _history.is_at_newest then _buffer.snapshot() else null fi

                        if let recalled = _history.previous() then
                            if draft? then
                                _draft = draft
                            fi

                            _buffer.replace(recalled)
                        fi
                    fi
                when System.ConsoleKey.DOWN_ARROW then
                    if !_buffer.down() /\ !_history.is_at_newest then
                        if let recalled = _history.next() then
                            _buffer.replace(recalled)
                        elif let draft = _draft then
                            _buffer.restore(draft)
                            _draft = null
                        else
                            _buffer.clear()
                        fi
                    fi
                when System.ConsoleKey.TAB then
                    if (modifiers & System.ConsoleModifiers.SHIFT) == System.ConsoleModifiers.SHIFT then
                        _hover_at()
                    else
                        _complete_at()
                    fi
                else
                    if is_control /\ key.key == System.ConsoleKey.A then
                        _buffer.home()
                    elif is_control /\ key.key == System.ConsoleKey.E then
                        _buffer.end()
                    elif is_alt /\ key.key == System.ConsoleKey.B then
                        _buffer.word_left()
                    elif is_alt /\ key.key == System.ConsoleKey.F then
                        _buffer.word_right()
                    elif is_control /\ key.key == System.ConsoleKey.U then
                        _buffer.kill_to_start()
                    elif is_control /\ key.key == System.ConsoleKey.K then
                        _buffer.kill_to_end()
                    elif is_control /\ key.key == System.ConsoleKey.W then
                        _buffer.delete_word_before()
                    elif is_control /\ key.key == System.ConsoleKey.B then
                        _buffer.left()
                    elif is_control /\ key.key == System.ConsoleKey.F then
                        _buffer.right()
                    elif is_control /\ key.key == System.ConsoleKey.L then
                        // Clears the screen, leaving the cell at the top.
                        Std.write("{_escape}[H{_escape}[2J")
                        _cursor_screen_row = 0
                    elif is_control /\ key.key == System.ConsoleKey.D then
                        if _buffer.is_blank /\ _buffer.lines.count == 1 then
                            _finish("")

                            return null
                        fi

                        _buffer.delete()
                    elif !is_control /\ key.key_char >= ' ' then
                        _buffer.insert(key.key_char.to_string())
                    fi
                esac

                _draw()
            od
        si

        // Alt-Enter: the whole cell submitted from whatever line the cursor
        // is on, as it stands, showing the value it ends on. Null for a
        // blank cell, which submits nothing.
        _submit_now() -> CELL_READ? is
            let text = CELL_TEXT.without_terminator(_buffer.lines)

            if text.trim().length == 0 then
                return null
            fi

            _buffer.to_end()
            _finish("")

            _history.add(text)

            let is_command = !text.contains('\n') /\ text.trim().starts_with(":")

            return CELL_READ(if is_command then text else "{text}\n" fi, CellStep.SUBMIT, is_command)
        si

        // One name on offer is written in. Several are written in as far
        // as they agree, and listed below the cell.
        _complete_at() is
            let offered = _complete(_buffer.text, _buffer.row + 1, _buffer.column + 1)

            if !offered? \/ offered.count == 0 then
                return
            fi

            let typed = _buffer.name_before_cursor
            let extension = CELL_BUFFER.extension(typed, offered)

            if extension.length > 0 then
                _buffer.insert(extension)

                if offered.count > 1 then
                    _show_below(COMPLETION_QUERY.columns(offered, _width, 6))
                fi
            elif offered.count > 1 then
                // Nothing more they share: a Tab now offers them to choose
                // from, the first written in.
                let menu = COMPLETION_MENU(offered, typed, _width, 6)

                _menu = menu
                _buffer.replace_name_before_cursor(menu.chosen)
            fi
        si

        // A key while the menu is shown. Tab, Right and Down move to the
        // next name and Shift-Tab, Left and Up back, writing it in; Enter
        // keeps the name written in and Escape puts back what was typed.
        // Any other key keeps the name and is then taken as usual, which
        // is what false says.
        _menu_key(menu: COMPLETION_MENU, key: System.ConsoleKeyInfo, is_alt: bool) -> bool is
            let is_shift = (key.modifiers & System.ConsoleModifiers.SHIFT) == System.ConsoleModifiers.SHIFT

            case key.key
            when System.ConsoleKey.TAB then
                if is_shift then menu.previous() else menu.next() fi
            when System.ConsoleKey.RIGHT_ARROW then
                menu.next()
            when System.ConsoleKey.LEFT_ARROW then
                menu.previous()
            when System.ConsoleKey.DOWN_ARROW then
                menu.down()
            when System.ConsoleKey.UP_ARROW then
                menu.up()
            when System.ConsoleKey.ENTER then
                _menu = null

                if is_alt then
                    return false
                fi

                _draw()

                return true
            when System.ConsoleKey.ESCAPE then
                _menu = null

                if _key_arrives_soon() then
                    return false
                fi

                _buffer.replace_name_before_cursor(menu.typed)
                _draw()

                return true
            else
                _menu = null

                return false
            esac

            _buffer.replace_name_before_cursor(menu.chosen)
            _draw()

            return true
        si

        // What the name at the cursor is, shown below the cell.
        _hover_at() is
            let column = _buffer.hover_column

            if column < 1 then
                return
            fi

            if let shown = _hover(_buffer.text, _buffer.row + 1, column) then
                _show_below(LIST[string]([shown]))
            fi
        si

        // Lines written below the cell, leaving the cursor where it was
        // for the redraw that follows to draw the cell again under them.
        _show_below(lines: Collections.List[string]) is
            let row = _buffer.row
            let column = _buffer.column

            _buffer.to_end()
            _draw()
            Std.write("\r\n")

            for line in lines do
                Std.write_line(line)
            od

            _buffer.move_to(row, column)
            _cursor_screen_row = 0
        si

        // Ctrl-C with something typed: the cell is left on the screen, all
        // of it, marked ^C, and kept in history as its newest entry, and an
        // empty cell under the same number takes its place. It was never
        // submitted, so nothing else knows it existed. With nothing typed,
        // Ctrl-C does nothing.
        _abandon() is
            let text = CELL_TEXT.without_terminator(_buffer.lines)

            if text.trim().length == 0 then
                return
            fi

            _menu = null

            _write_whole("^C")

            _history.add(text)

            _buffer.clear()
            _end.clear()
            _draft = null
            _top = 0

            _draw()
        si

        // Every line of the cell written from its first row, whatever part
        // of it was shown before, then `suffix` and a line break, so the
        // cell stays on the screen as it was typed.
        _write_whole(suffix: string) is
            let lines = _buffer.lines
            let output = System.Text.StringBuilder()

            if _cursor_screen_row > 0 then
                output.append("{_escape}[{_cursor_screen_row}A")
            fi

            output.append("\r{_escape}[J")

            let context = LIST[string]()

            for i in 0..lines.count do
                if i > 0 then
                    output.append("\r\n")
                fi

                output.append(if i == 0 then _prompt else _continuation fi)
                output.append(_painted(lines[i], context))

                context.add(lines[i])
            od

            output.append("{suffix}\r\n")

            Std.write(output.to_string())

            _cursor_screen_row = 0
        si

        // The cell drawn with the cursor at its end, then a line break, so
        // what follows is written below it.
        _finish(suffix: string) is
            _buffer.to_end()
            _draw()

            Std.write("{suffix}\r\n")

            _cursor_screen_row = 0
        si

        _width: int is
            try
                let width = Std.window_width

                return if width > 0 then width else 80 fi
            catch e: System.Exception
                return 80
            yrt
        si

        _height: int is
            try
                let height = Std.window_height

                return if height > 1 then height else 24 fi
            catch e: System.Exception
                return 24
            yrt
        si

        // The whole cell written again from its first row, or as much of
        // it around the cursor as fits the terminal, with the cursor put
        // back where it is in the text.
        _draw() is
            let lines = _buffer.lines
            let width = _width
            let layout = CELL_LAYOUT(width, _prompt.length)

            let below = _menu?.lines(name => "{_escape}[7m{name}{_escape}[27m")
            let room = System.Math.max(1, _height - 1 - (below?.count ?? 0))

            _top = layout.top(lines, _buffer.row, _top, room)

            let bottom = layout.bottom(lines, _top, room)

            let output = System.Text.StringBuilder()

            if _cursor_screen_row > 0 then
                output.append("{_escape}[{_cursor_screen_row}A")
            fi

            output.append("\r{_escape}[J")

            let context = LIST[string]()

            for i in 0.._top do
                context.add(lines[i])
            od

            let rows mut = 0

            for i in _top..bottom do
                if i > _top then
                    output.append("\r\n")
                fi

                output.append(if i == 0 then _prompt else _continuation fi)
                output.append(_painted(lines[i], context))

                context.add(lines[i])
                rows = rows + layout.rows(lines[i])
            od

            if let menu_lines = below then
                for line in menu_lines do
                    output.append("\r\n{line}")
                    rows = rows + 1
                od
            fi

            // Where the cursor is left, counted in rows from the first drawn
            // row, and where it has to go.
            let end_row = rows - 1
            let target = layout.cursor(lines, _top, _buffer.row, _buffer.column)

            if end_row > target.row then
                output.append("{_escape}[{end_row - target.row}A")
            fi

            output.append("\r")

            if target.column > 0 then
                output.append("{_escape}[{target.column}C")
            fi

            Std.write(output.to_string())

            _cursor_screen_row = target.row
        si

        _painted(text: string, before: Collections.List[string]) -> string is
            if let palette = _palette then
                return palette.paint(text, LINE_SPANS.of_last_line(before, text))
            fi

            return text
        si

        // Whether the keys waiting to be read are `expected`, which they
        // are only when a terminal sent them together; anything else
        // waiting is consumed with them.
        _follows(expected: string) -> bool is
            for c in expected do
                if !_key_arrives_soon() then
                    return false
                fi

                if Std.read_key(true).key_char != c then
                    return false
                fi
            od

            return true
        si

        _key_arrives_soon() -> bool is
            for i in 0..20 do
                if Std.key_available then
                    return true
                fi

                System.Threading.Thread.sleep(1)
            od

            return false
        si

        // The text of a paste, up to the marker that ends it, with every
        // line break as a newline.
        _read_paste() -> string is
            let text = System.Text.StringBuilder()
            let end_marker = "{_escape}[201~"

            do
                let key = Std.read_key(true)
                let c = if key.key == System.ConsoleKey.ENTER then '\n' else key.key_char fi

                text.append(c)

                if text.length >= end_marker.length /\ text.to_string().ends_with(end_marker, System.StringComparison.ORDINAL) then
                    return text.to_string(0, text.length - end_marker.length).replace("\r\n", "\n").replace('\r', '\n')
                fi
            od
        si
    si

    // Where the lines of a cell fall on a terminal `width` columns wide,
    // each after a prompt `prompt_width` columns wide: how many rows each
    // takes, which lines fit, and where the cursor goes.
    class CELL_LAYOUT(_width: int, _prompt_width: int) is
        rows(line: string) -> int =>
            System.Math.max(1, (_prompt_width + line.length + _width - 1) / _width)

        // The first line to draw: the one before unless the cursor's line
        // is above it, or would fall below what fits.
        top(lines: Collections.List[string], cursor_row: int, previous_top: int, height: int) -> int is
            let top mut = System.Math.min(previous_top, cursor_row)

            while top < cursor_row /\ _rows_between(lines, top, cursor_row + 1) > height do
                top = top + 1
            od

            return top
        si

        // One past the last line to draw from `top`, as many as fit.
        bottom(lines: Collections.List[string], top: int, height: int) -> int is
            let used mut = 0
            let bottom mut = top

            while bottom < lines.count /\ (bottom == top \/ used + rows(lines[bottom]) <= height) do
                used = used + rows(lines[bottom])
                bottom = bottom + 1
            od

            return bottom
        si

        // The row and column of the cursor, counted from the first line
        // drawn.
        cursor(lines: Collections.List[string], top: int, row: int, column: int) -> (row: int, column: int) is
            let offset = _prompt_width + column
            let within =
                if offset > 0 /\ offset == _prompt_width + lines[row].length /\ offset % _width == 0 then
                    // At the very end of a line that fills its last row the
                    // terminal leaves the cursor on that row.
                    offset / _width - 1
                else
                    offset / _width
                fi

            let column_on_row =
                if offset > 0 /\ offset % _width == 0 /\ within < offset / _width then
                    _width - 1
                else
                    offset % _width
                fi

            return (row = _rows_between(lines, top, row) + within, column = column_on_row)
        si

        _rows_between(lines: Collections.List[string], from: int, to: int) -> int is
            let total mut = 0

            for i in from..to do
                total = total + rows(lines[i])
            od

            return total
        si
    si
si
