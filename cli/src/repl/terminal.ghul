namespace Ghul.Cli.Repl is
    use Ghul.Repl.Host.HELD_CONSTRUCT
    use Collections.LIST
    use Ghul.Repl.CELL_DISPLAY
    use Ghul.Repl.CELL_TAIL
    use Ghul.Repl.NOTEBOOK
    use Ghul.Repl.NOTEBOOK_CELL
    use Ghul.Repl.Host.GHUL_LEXER
    use IO.Std
    use Ghul.Repl.Host.Completeness
    use Ghul.Repl.Host.CELL_END
    use Ghul.Repl.Host.CellStep
    use Ghul.Repl.Host.HOSTED_SESSION
    use Ghul.Repl.Host.SUBMIT_RESULT

    // The lines of the cell being entered, and when it ends. Completeness
    // is asked of the compiler as each line is entered. Text it calls
    // unfinished - an open block, an open bracket, an operator with
    // nothing after it - waits for another line, and text that can never
    // be finished is submitted straight away so its errors are reported.
    //
    // Finished text is submitted at once, with one exception at a
    // terminal: text ending on an if, a case, a loop, a try or a
    // definition written over several lines keeps the cell open for more.
    // A blank line then submits it without showing a value, and a line
    // holding only `.` submits it showing the value it ends on. Read from
    // anything else, finished text is always submitted at once.
    //
    // A blank line submits unfinished text regardless, and so does a
    // `.` line. Neither is part of the cell.
    class CELL_INPUT(_check: (string) -> Completeness, _is_interactive: bool) is
        _lines: LIST[string]

        // Whether the lines so far are finished text ending on a
        // construct over several lines that holds the cell open.
        _is_held: bool

        // Where the statement the latest line belongs to starts.
        _statement_start: int

        is_empty: bool => _lines.count == 0

        // The lines entered so far, for an editor to read.
        lines: Collections.List[string] => _lines

        // The cell's source, once a step has said to submit it.
        source: string => "{_lines |> Ghul.Pipes.join("\n")}\n"

        init(..) is
            _lines = LIST[string]()
        si

        enter(line: string) -> CellStep is
            // A lone backslash at the end of a line keeps the cell open,
            // whatever the rest of it would do.
            if let continued = CONTINUATION.strip(line) then
                _add(continued)

                return CellStep.WAIT
            fi

            let trimmed = line.trim()

            if trimmed =~ "." then
                return if is_empty then CellStep.NOTHING else CellStep.SUBMIT fi
            fi

            if trimmed.length == 0 then
                if is_empty then
                    return CellStep.NOTHING
                fi

                return if _is_held then CellStep.SUBMIT_QUIETLY else CellStep.SUBMIT fi
            fi

            let was_finished = is_empty \/ _is_held

            _add(line)

            case _check(source)
            when Completeness.INCOMPLETE then
                return CellStep.WAIT
            when Completeness.INVALID then
                return CellStep.SUBMIT
            else
                if !_is_interactive \/ was_finished \/ !HELD_CONSTRUCT.starts(_lines, _statement_start) then
                    return CellStep.SUBMIT
                fi

                _is_held = true

                return CellStep.WAIT
            esac
        si

        // A line pasted as part of a block, taken as it is: it neither
        // submits nor holds, and whatever is entered after the paste
        // decides that for the whole cell.
        append(line: string) is
            _add(line)
        si

        _add(line: string) is
            if is_empty \/ _is_held then
                _statement_start = _lines.count
            fi

            _lines.add(line)
            _is_held = false
        si

        clear() is
            _lines.clear()
            _is_held = false
            _statement_start = 0
        si
    si

    // The terminal front end: read a submission, hand it to the session,
    // report what happened. Everything it knows about a cell it learns
    // from SESSION, so a notebook or the playground can take its place
    // without any of this. What was submitted is kept as a NOTEBOOK, so
    // an earlier cell can be edited and run again where it is, and the
    // cells above or below it run again after it, as in a notebook.
    class TERMINAL(
        _make_session: () -> HOSTED_SESSION,
        _want_default_use: bool,
        _theme: ThemeChoice,
        _completes_at_cursor: bool
    ) is
        _display: CELL_DISPLAY

        // The session's cells, in the order they were entered, each
        // holding its latest text.
        _notebook: NOTEBOOK

        // Whether a value is shown with its type, as `:types` sets it.
        _show_types: bool
        _current: HOSTED_SESSION?

        // What code and diagnostics are coloured with at a terminal.
        _colours: PALETTE?

        // At a terminal the whole cell is edited in place; anything else
        // is read a line at a time and judged by CELL_INPUT as it comes.
        _editor: CELL_EDITOR?
        _cell: CELL_INPUT
        _reader: PLAIN_READER

        init(..) is
            _display = CELL_DISPLAY()
            _notebook = NOTEBOOK()
            _show_types = true

            let is_interactive = !Std.is_input_redirected /\ !Std.is_output_redirected

            // Asked of the session in use, whose compile server answers
            // it once it is ready.
            let check = (text: string) -> Completeness =>
                if let session = _current then session.check(text) else Completeness.COMPLETE fi

            _cell = CELL_INPUT(check, is_interactive)
            _reader = PLAIN_READER()

            if is_interactive then
                let check_ending = (text: string) -> Ghul.Repl.Host.CHECK_ANSWER =>
                    if let session = _current then
                        session.check_ending(text)
                    else
                        Ghul.Repl.Host.CHECK_ANSWER(Completeness.COMPLETE, null)
                    fi

                _colours = _palette()
                _editor = CELL_EDITOR(
                    (text, line, column) => _names(text, line, column),
                    (text, line, column) => _current?.hover(text, line, column),
                    _colours,
                    CELL_END(check_ending))
            fi
        si

        // How diagnostics are coloured, if at all: not when they are
        // written somewhere other than the terminal.
        _diagnostic_colours() -> Ghul.Repl.DiagnosticColours? =>
            if let palette = _colours /\ !Std.is_error_redirected then PALETTE_DIAGNOSTIC_COLOURS(palette) else null fi

        // What the input is coloured with at a terminal, if anything.
        _palette() -> PALETTE? is
            let environment = (name: string) -> string? => System.Environment.get_environment_variable(name)

            return COLOUR_CHOICE.palette(
                _theme,
                COLOUR_CHOICE.depth(environment),
                () => BACKGROUND_QUERY.ask(200),
                environment("COLORFGBG"))
        si

        run() -> int is
            Std.write_line("ghūl repl. :help for commands.")

            let session mut = _make_session()

            session.set_display_sink(TERMINAL_DISPLAY_SINK(() => session.runtime))

            _current = session

            loop: do
                let read = _read()

                if !read? then
                    Std.write_line("")

                    break loop
                fi

                if read.is_command then
                    let command = read.source.trim()

                    case command
                    when ":quit", ":q" then
                        break loop
                    when ":reset" then
                        session.close()
                        session = _make_session()
                        session.set_display_sink(TERMINAL_DISPLAY_SINK(() => session.runtime))
                        _current = session
                        _notebook = NOTEBOOK()
                        _pending_edit = null

                        Std.write_line("session reset")
                    when ":help" then
                        _write_help()
                    else
                        if command.starts_with(":rerun ") then
                            _rerun(session, command.substring(":rerun ".length).trim())
                        elif command.starts_with(":edit ") then
                            _edit(session, command.substring(":edit ".length).trim())
                        elif command =~ ":cells" then
                            _write_lines(CELL_LISTING.summary(_notebook, 20))
                        elif command.starts_with(":cells ") then
                            _write_lines(CELL_LISTING.cell(_notebook, command.substring(":cells ".length).trim()))
                        elif command.starts_with(":complete ") then
                            _complete(session, command.substring(":complete ".length))
                        elif command.starts_with(":hover ") then
                            _hover(session, command.substring(":hover ".length))
                        elif command.starts_with(":ref ") then
                            _reference(session, command.substring(":ref ".length).trim())
                        elif command.starts_with(":nuget ") then
                            _package(session, command.substring(":nuget ".length).trim())
                        elif command =~ ":types" \/ command.starts_with(":types ") then
                            _types(command.substring(":types".length).trim())
                        elif command.starts_with(":type ") then
                            _type(session, command.substring(":type ".length))
                        elif command.starts_with(":save ") then
                            _save(session, command.substring(":save ".length).trim())
                        elif command.starts_with(":load ") then
                            _load(session, command.substring(":load ".length).trim())
                        else
                            Std.write_line("unknown command {command}; :help for the list")
                        fi
                    esac

                    continue
                fi

                if read.step == CellStep.NOTHING then
                    continue
                fi

                let result = _run(session, read.cell, read.source, read.step == CellStep.SUBMIT)

                if let cell = read.cell then
                    _note_out_of_date(cell, result)
                fi
            od

            session.close()
            _editor?.close()

            return 0
        si

        // Submits `source` as the notebook cell `cell`, or as a new cell at
        // the end when there is none, and reports it.
        _run(session: HOSTED_SESSION, cell: NOTEBOOK_CELL?, source: string, want_value: bool) -> SUBMIT_RESULT is
            let number = session.next_cell_number

            let result =
                if want_value then
                    session.submit(source, _presenter(session))
                else
                    session.submit(source)
                fi

            _notebook.ran(cell ?? _notebook.add(source), number, source, result.status)

            _report(session, result, want_value, number, source)

            return result
        si

        // After an earlier cell has run again: which cells below it ran
        // before it, so may be using what it defined before.
        _note_out_of_date(cell: NOTEBOOK_CELL, result: SUBMIT_RESULT) is
            if !result.is_accepted then
                return
            fi

            let below = _notebook.out_of_date_below(cell)

            if below.count == 0 then
                return
            fi

            let numbers = LIST[string]()

            for c in below do
                numbers.add("{c.number ?? 0}")
            od

            let first = numbers[0]

            if numbers.count == 1 then
                Std.error.write_line("ghul: cell {first}, below this one, ran before it; :rerun {first}.. runs it again")
            else
                let listed = "{numbers |> Ghul.Pipes.take(numbers.count - 1) |> Ghul.Pipes.join(", ")} and {numbers[numbers.count - 1]}"

                Std.error.write_line("ghul: cells {listed}, below this one, ran before it; :rerun {first}.. runs them again")
            fi
        si

        // The notebook cell to be edited next: at a terminal it is brought
        // up at the next prompt, and otherwise the next cell entered
        // replaces it.
        _pending_edit: NOTEBOOK_CELL?

        _edit(session: HOSTED_SESSION, argument: string) is
            let number mut = 0

            if !int.try_parse(argument, number ref) then
                Std.write_line("usage: :edit N")

                return
            fi

            if let cell = _notebook.with_number(number) then
                _pending_edit = cell

                if !_editor? then
                    Std.write_line("the next cell entered replaces cell {cell.number ?? number}")
                fi

                return
            fi

            Std.write_line("no cell {number}")
        si

        // `:rerun N` runs cell N again where it is; `:rerun N..` runs N and
        // every cell after it, and `:rerun ..N` every cell before N, in
        // order, stopping at the first that does not run to the end. A
        // cell whose last run did not compile, and which has not been
        // edited since, is passed over by either.
        _rerun(session: HOSTED_SESSION, argument: string) is
            let is_from = argument.ends_with("..")
            let is_above = !is_from /\ argument.starts_with("..")
            let digits =
                if is_from then
                    argument.substring(0, argument.length - 2).trim()
                elif is_above then
                    argument.substring(2).trim()
                else
                    argument
                fi

            let number mut = 0

            if !int.try_parse(digits, number ref) then
                Std.write_line("usage: :rerun N, :rerun N.. for N and every cell after it, or :rerun ..N for every cell before N")

                return
            fi

            let found = _notebook.with_number(number)

            if !found? then
                Std.write_line("no cell {number}")

                return
            fi

            let cells =
                if is_from then
                    _notebook.from(found)
                elif is_above then
                    _notebook.above(found)
                else
                    LIST[NOTEBOOK_CELL]([found])
                fi

            if cells.count == 0 then
                Std.write_line("nothing above cell {number} to run")

                return
            fi

            let is_range = is_from \/ is_above

            for cell in cells do
                let old_number = cell.number
                let new_number = session.next_cell_number
                let source = cell.source

                _show_replayed(new_number, source)

                let result = _run(session, cell, source, true)

                if is_range /\ (!result.is_accepted \/ result.was_interrupted \/ result.run_error?) then
                    let was = if let n = old_number then ", which was cell {n}" else "" fi

                    Std.write_line("ghul: stopped at cell {new_number}{was}; the cells after it were not run")

                    return
                fi

                if !is_from /\ cell == cells[cells.count - 1] then
                    _note_out_of_date(cell, result)
                fi
            od
        si

        // A rerun cell's text, written as though it had been typed at its
        // own prompt.
        _show_replayed(number: int, source: string) is
            let prompt = "{number}> "
            let continuation = "{string(' ', prompt.length - 2)}| "
            let lines = source.trim_end(['\n']).split(['\n'])

            for i in 0..lines.count do
                Std.write_line("{if i == 0 then prompt else continuation fi}{lines[i]}")
            od
        si

        _write_lines(lines: Collections.Iterable[string]) is
            for line in lines do
                Std.write_line(line)
            od
        si

        // The next cell, or null when the input has ended.
        _read() -> CELL_READ? is
            let editing = _pending_edit
            _pending_edit = null

            if let editor = _editor then
                return editor.read_cell(_current?.next_cell_number ?? 1, _notebook, editing)
            fi

            do
                let line = _reader.read_line(if _cell.is_empty then "> " else "| " fi)

                if !line? then
                    return null
                fi

                if _cell.is_empty /\ line.trim().starts_with(":") then
                    _pending_edit = editing

                    return CELL_READ(line, CellStep.SUBMIT, true)
                fi

                let step = _cell.enter(line)

                if step != CellStep.NOTHING /\ step != CellStep.WAIT then
                    let source = _cell.source

                    _cell.clear()

                    return CELL_READ(source, step, false, editing)
                fi
            od
        si

        // For Ctrl-C, from the signal it raises: interrupts the cell running
        // now and says the signal is dealt with. At a terminal it is dealt
        // with regardless, since the cell editor reads Ctrl-C as a key when
        // no cell runs; for other input it ends the session.
        on_interrupt() -> bool is
            if let session = _current /\ session.interrupt() then
                return true
            fi

            if _editor? then
                return true
            fi

            close()

            return false
        si

        // For a signal that ends the process: closes the session in use
        // now, whatever the loop is doing.
        close() is
            _current?.close()
        si

        // How a cell's value is shown, run on the cell's own thread after the
        // cell, so Ctrl-C stops a value that never finishes showing itself
        // as it stops the cell.
        _presenter(session: HOSTED_SESSION) -> (object?) -> object? =>
            value => (_display.use_runtime(session.runtime); _display.format(value))

        _report(session: HOSTED_SESSION, result: SUBMIT_RESULT, want_value: bool, number: int, source: string) is
            for line in Ghul.Repl.DIAGNOSTIC_VIEW.lines(result.diagnostics, "cell-{number}", source, _diagnostic_colours()) do
                Std.error.write_line(line)
            od

            // After whatever the cell itself wrote, so a cell that
            // prints and then ends on a value reads in the order it ran.
            if want_value then
                if let shown = cast string?(result.value) then
                    Std.write_line(_with_type(session, source, shown))
                fi
            fi

            if result.was_interrupted then
                Std.error.write_line("ghul: {SUBMIT_RESULT.INTERRUPTED_NOTE}")

                return
            fi

            if let error = result.run_error then
                Std.error.write_line(error)

                // It compiled, so what it declared is there for later
                // cells whatever its own code then did.
                Std.error.write_line("ghul: the cell was kept: it compiled, so its definitions are in the session")
            fi
        si

        // The names that could complete the one being typed at a line and
        // column of text, both from 1.
        _names(text: string, line: int, column: int) -> Collections.List[string]? is
            let lines = text.split(['\n'])
            let line_text = if line >= 1 /\ line <= lines.count then lines[line - 1] else "" fi
            let typed = COMPLETION_QUERY.prefix(line_text, column - 1)

            let asked_at = if _completes_at_cursor then column else column - typed.length fi
            let offered = _current?.complete(text, line, asked_at)

            if !offered? then
                return null
            fi

            let names = LIST[string]()

            for item in offered do
                names.add(item.name)
            od

            return COMPLETION_QUERY.narrow(names, typed)
        si

        // What could follow some text, one name to a line.
        _complete(session: HOSTED_SESSION, text: string) is
            if let names = _names(text, 1, text.length + 1) then
                for name in names do
                    Std.write_line(name)
                od
            else
                Std.write_line("completion is not available")
            fi
        si

        // An assembly file, referenced by the cells after it.
        _reference(session: HOSTED_SESSION, path: string) is
            if path.length == 0 then
                Std.write_line("usage: :ref FILE")

                return
            fi

            _report_references(session.add_reference(path))
        si

        // A NuGet package, `NAME` or `NAME VERSION`, and what it depends on,
        // referenced by the cells after it.
        _package(session: HOSTED_SESSION, argument: string) is
            let parts = argument.split([' '], System.StringSplitOptions.REMOVE_EMPTY_ENTRIES)

            if parts.count < 1 \/ parts.count > 2 then
                Std.write_line("usage: :nuget PACKAGE [VERSION]")

                return
            fi

            Std.write_line("restoring {parts[0]}...")

            _report_references(session.add_package(parts[0], if parts.count > 1 then parts[1] else null fi))
        si

        _report_references(added: Ghul.Repl.Host.ADDED_REFERENCES) is
            if added.names.count > 0 then
                Std.write_line("referenced {added.names |> Ghul.Pipes.join(", ")}")
            fi

            if let problem = added.problem then
                Std.write_line(problem)
            elif added.names.count == 0 then
                Std.write_line("nothing new to reference")
            fi
        si

        // A value the cell ended on, after the type of the expression it
        // ended on where the analyser can say what that is. The expression
        // is asked about as `:type` asks, so it is not run again.
        _with_type(session: HOSTED_SESSION, source: string, shown: string) -> string is
            if !_show_types then
                return shown
            fi

            if let tail = CELL_TAIL.of(source),
                hovered = session.hover(TYPE_QUERY.probe(tail), 1, TYPE_QUERY.column),
                type = TYPE_QUERY.type_from_hover(hovered) /\ !type.contains("!!!")
            then
                let painted = if let palette = _colours /\ !Std.is_output_redirected then palette.paint(type, GHUL_LEXER.spans(type)) else type fi

                return "{painted}: {shown}"
            fi

            return shown
        si

        // `:types on` and `:types off`: whether values are shown with their
        // types. `:types` alone says which.
        _types(argument: string) is
            if argument =~ "on" then
                _show_types = true
            elif argument =~ "off" then
                _show_types = false
            elif argument.length > 0 then
                Std.write_line("usage: :types on, or :types off")

                return
            fi

            Std.write_line(if _show_types then "values are shown with their types" else "values are shown without their types" fi)
        si

        // The type of an expression, which is compiled but not run.
        _type(session: HOSTED_SESSION, expression: string) is
            if expression.trim().length == 0 then
                Std.write_line("usage: :type EXPRESSION")

                return
            fi

            if let shown = session.hover(TYPE_QUERY.probe(expression), 1, TYPE_QUERY.column) then
                if let type = TYPE_QUERY.type_from_hover(shown) then
                    Std.write_line(type)

                    return
                fi
            fi

            if session.is_analysis_available then
                Std.write_line("no type for that")
            else
                Std.write_line("types are not available")
            fi
        si

        // The cells that ran to the end, written to a file `:load` reads.
        _save(session: HOSTED_SESSION, path: string) is
            if path.length == 0 then
                Std.write_line("usage: :save FILE")

                return
            fi

            let text = SCRIPT_FILE.text(_notebook)

            try
                IO.File.write_all_text(path, text)
            catch e: System.Exception
                Std.write_line("cannot write {path}: {e.message}")

                return
            yrt

            Std.write_line("saved to {path}")
        si

        // A file's cells submitted in order, each shown as if typed,
        // stopping at the first that does not run to the end.
        _load(session: HOSTED_SESSION, path: string) is
            if path.length == 0 then
                Std.write_line("usage: :load FILE")

                return
            fi

            let text mut = ""

            try
                text = IO.File.read_all_text(path)
            catch e: System.Exception
                Std.write_line("cannot read {path}: {e.message}")

                return
            yrt

            for cell in SCRIPT_FILE.cells(text) do
                let number = session.next_cell_number

                _show_replayed(number, cell)

                let result = _run(session, null, "{cell}\n", true)

                if !result.is_accepted \/ result.was_interrupted \/ result.run_error? then
                    Std.write_line("ghul: stopped at cell {number}; the rest of {path} was not loaded")

                    return
                fi
            od
        si

        // The declaration the last character of some text belongs to.
        _hover(session: HOSTED_SESSION, text: string) is
            if let shown = session.hover(text, 1, text.length) then
                Std.write_line(shown)
            elif session.is_analysis_available then
                Std.write_line("nothing there")
            else
                Std.write_line("hover is not available")
            fi
        si

        _write_help() is
            Std.write_line(":help            this list")
            Std.write_line(":reset           start a new session, forgetting every cell")
            Std.write_line(":cells           the cells so far, in order: number, how each last ran, its")
            Std.write_line("                 first line, and whether it has been edited or is out of date")
            Std.write_line(":cells N         the whole of cell N")
            Std.write_line(":edit N          edit cell N where it is; running it runs it again in its place")
            Std.write_line(":rerun N         run cell N again, in its place")
            Std.write_line(":rerun N..       run cell N and every cell after it, in order")
            Std.write_line(":rerun ..N       run every cell before cell N, in order")
            Std.write_line("                 either stops at the first cell that does not run to the end")
            Std.write_line(":complete TEXT   what could follow TEXT")
            Std.write_line(":hover TEXT      what the end of TEXT names")
            Std.write_line(":type EXPR       the type of EXPR, without running it")
            Std.write_line(":types on|off    show each value with its type, or without (on)")
            Std.write_line(":ref FILE        reference an assembly in later cells")
            Std.write_line(":nuget PKG [V]   reference a NuGet package in later cells")
            Std.write_line(":save FILE       write the cells that ran to the end to FILE")
            Std.write_line(":load FILE       submit the cells in FILE, in order")
            Std.write_line(":quit            leave")
            Std.write_line("")
            Std.write_line("a line that finishes an expression or a call submits what you have typed;")
            Std.write_line("a let, an assignment or a definition, or an if, case, loop or try over")
            Std.write_line("several lines, does not end the submission: keep typing, or end it with")
            Std.write_line("a blank line; a line that leaves something open waits for more")
            Std.write_line("a line holding only . ends the submission and shows what it ended on")
            Std.write_line("a submission is submitted from its last line; Enter on an earlier line adds")
            Std.write_line("a line, and Alt-Enter submits from any line, showing what it ended on")
            Std.write_line("a line ending in a lone \\ keeps the submission open; the \\ is dropped")
            Std.write_line("Up and Down move between lines, then between the cells so far, each edited")
            Std.write_line("where it is under its own number, then back through history; running an")
            Std.write_line("earlier cell runs it again in its place, as the next number, and later cells")
            Std.write_line("then see what it defines; Ctrl-D in an empty submission leaves")
            Std.write_line("Ctrl-Left and Ctrl-Right (or Alt-B and Alt-F) move by a word; Ctrl-U and")
            Std.write_line("Ctrl-K delete to the start or end of the line, Ctrl-W the word before the")
            Std.write_line("cursor; Ctrl-L clears the screen; Tab completes, listing the names on offer,")
            Std.write_line("and Tab again chooses among them with Tab and the arrows, Enter or Escape;")
            Std.write_line("Shift-Tab shows what the name at the cursor is")
            Std.write_line("Ctrl-C while a submission runs interrupts it; the session carries on")
            Std.write_line("Ctrl-C at the prompt sets what you have typed aside in history and starts again;")
            Std.write_line("on an earlier cell it puts back what the cell last ran")
            Std.write_line("what you end on is shown, unless you end on a statement or with a blank line")
            Std.write_line("messages call a cell cell-3; in code it is cell3, as in cell3.x")

            if _want_default_use then
                Std.write_line("the compiler's default imports (use default) are in force in every cell")
            fi
        si
    si
si
