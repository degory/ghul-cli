namespace Ghul.Cli.Repl is
    use Collections.LIST
    use Ghul.Repl.CELL_DISPLAY
    use IO.Std
    use Ghul.Repl.Host.Completeness
    use Ghul.Repl.Host.HOSTED_SESSION
    use Ghul.Repl.Host.SUBMIT_RESULT

    // What a line typed at the prompt does to the cell being entered.
    enum CellStep is
        // Nothing to do: a blank line or a lone `.` with nothing typed.
        NOTHING,

        // Keep reading lines into the same cell.
        WAIT,

        // Submit the cell and show the value it ends on.
        SUBMIT,

        // Submit the cell without showing the value it ends on.
        SUBMIT_QUIETLY
    si

    // The lines of the cell being entered, and when it ends. Completeness
    // is asked of the compiler as each line is entered. Text it calls
    // unfinished - an open block, an open bracket, an operator with
    // nothing after it - waits for another line, and text that can never
    // be finished is submitted straight away so its errors are reported.
    //
    // Finished text is submitted at once, with one exception at a
    // terminal: text ending on an if, a case, a loop, a try or a
    // definition written over several lines keeps the cell open for more.
    // A blank line then submits it without showing a value, and a line
    // holding only `.` submits it showing the value it ends on. Read from
    // anything else, finished text is always submitted at once.
    //
    // A blank line submits unfinished text regardless, and so does a
    // `.` line. Neither is part of the cell.
    class CELL_INPUT(_check: (string) -> Completeness, _is_interactive: bool) is
        _lines: LIST[string]

        // Whether the lines so far are finished text ending on a
        // construct over several lines that holds the cell open.
        _is_held: bool

        // Where the statement the latest line belongs to starts.
        _statement_start: int

        is_empty: bool => _lines.count == 0

        // The lines entered so far, for an editor to read.
        lines: Collections.List[string] => _lines

        // The cell's source, once a step has said to submit it.
        source: string => "{_lines |> Ghul.Pipes.join("\n")}\n"

        init(..) is
            _lines = LIST[string]()
        si

        enter(line: string) -> CellStep is
            // A lone backslash at the end of a line keeps the cell open,
            // whatever the rest of it would do.
            if let continued = CONTINUATION.strip(line) then
                _add(continued)

                return CellStep.WAIT
            fi

            let trimmed = line.trim()

            if trimmed =~ "." then
                return if is_empty then CellStep.NOTHING else CellStep.SUBMIT fi
            fi

            if trimmed.length == 0 then
                if is_empty then
                    return CellStep.NOTHING
                fi

                return if _is_held then CellStep.SUBMIT_QUIETLY else CellStep.SUBMIT fi
            fi

            let was_finished = is_empty \/ _is_held

            _add(line)

            case _check(source)
            when Completeness.INCOMPLETE then
                return CellStep.WAIT
            when Completeness.INVALID then
                return CellStep.SUBMIT
            else
                if !_is_interactive \/ was_finished \/ !HELD_CONSTRUCT.starts(_lines, _statement_start) then
                    return CellStep.SUBMIT
                fi

                _is_held = true

                return CellStep.WAIT
            esac
        si

        // A line pasted as part of a block, taken as it is: it neither
        // submits nor holds, and whatever is entered after the paste
        // decides that for the whole cell.
        append(line: string) is
            _add(line)
        si

        _add(line: string) is
            if is_empty \/ _is_held then
                _statement_start = _lines.count
            fi

            _lines.add(line)
            _is_held = false
        si

        clear() is
            _lines.clear()
            _is_held = false
            _statement_start = 0
        si
    si

    // Whether a statement over several lines is one that holds the cell
    // open when it closes: an if, a case, a loop, a try, or a
    // definition. Anything else - a let, an assignment, a call spread
    // over lines - is submitted as soon as it is finished.
    class HELD_CONSTRUCT is
        init() is si

        _openers: string[] static => ["if", "case", "for", "while", "do", "try"]

        _definitions: string[] static => [
            "class", "struct", "trait", "union", "enum", "namespace", "partial", "impl"
        ]

        starts(lines: Collections.List[string], start: int) -> bool static is
            let i mut = start

            // Pragmas written above a definition belong to it.
            while i < lines.count /\ (lines[i].trim().starts_with("@") \/ lines[i].trim().length == 0) do
                i = i + 1
            od

            if i >= lines.count then
                return false
            fi

            let first = lines[i].trim()
            let word mut = INDENTATION.first_word(first)

            // A labelled loop: `outer: for ...`.
            if first.length > word.length /\ first[word.length] == ':' then
                word = INDENTATION.first_word(first.substring(word.length + 1))
            fi

            for opener in _openers do
                if word =~ opener then
                    return true
                fi
            od

            for definition in _definitions do
                if word =~ definition then
                    return true
                fi
            od

            return _is_function_definition(first, word)
        si

        // A named function or method: a name and a parameter list, with
        // the line ending on the body's `is` or `=>`, or a return type.
        _is_function_definition(first: string, word: string) -> bool static is
            if word.length == 0 \/ first.length <= word.length then
                return false
            fi

            let after = first[word.length]

            if after != '(' /\ after != '[' then
                return false
            fi

            let code = first.trim_end()

            return code.ends_with(" is") \/ code.ends_with("=>") \/ code.contains(") ->")
        si
    si

    // The terminal front end: read a submission, hand it to the session,
    // report what happened. Everything it knows about a cell it learns
    // from SESSION, so a notebook or the playground can take its place
    // without any of this.
    class TERMINAL(_make_session: () -> HOSTED_SESSION, _want_default_use: bool, _theme: ThemeChoice) is
        _display: CELL_DISPLAY
        _current: HOSTED_SESSION?

        // What code and diagnostics are coloured with at a terminal.
        _colours: PALETTE?

        // At a terminal the whole cell is edited in place; anything else
        // is read a line at a time and judged by CELL_INPUT as it comes.
        _editor: CELL_EDITOR?
        _cell: CELL_INPUT
        _reader: PLAIN_READER

        init(..) is
            _display = CELL_DISPLAY()

            let is_interactive = !Std.is_input_redirected /\ !Std.is_output_redirected

            // Asked of the session in use, whose compile server answers
            // it once it is ready.
            let check = (text: string) -> Completeness =>
                if let session = _current then session.check(text) else Completeness.COMPLETE fi

            _cell = CELL_INPUT(check, is_interactive)
            _reader = PLAIN_READER()

            if is_interactive then
                let check_ending = (text: string) -> Ghul.Repl.Host.CHECK_ANSWER =>
                    if let session = _current then
                        session.check_ending(text)
                    else
                        Ghul.Repl.Host.CHECK_ANSWER(Completeness.COMPLETE, null)
                    fi

                _colours = _palette()
                _editor = CELL_EDITOR((text, line, column) => _names(text, line, column), _colours, CELL_END(check_ending))
            fi
        si

        // What the input is coloured with at a terminal, if anything.
        _palette() -> PALETTE? is
            let environment = (name: string) -> string? => System.Environment.get_environment_variable(name)

            return COLOUR_CHOICE.palette(
                _theme,
                COLOUR_CHOICE.depth(environment),
                () => BACKGROUND_QUERY.ask(200),
                environment("COLORFGBG"))
        si

        run() -> int is
            Std.write_line("ghūl repl. :help for commands.")

            let session mut = _make_session()

            _current = session

            loop: do
                let read = _read()

                if !read? then
                    Std.write_line("")

                    break loop
                fi

                if read.is_command then
                    let command = read.source.trim()

                    case command
                    when ":quit", ":q" then
                        break loop
                    when ":reset" then
                        session.close()
                        session = _make_session()
                        _current = session

                        Std.write_line("session reset")
                    when ":help" then
                        _write_help()
                    else
                        if command.starts_with(":rerun ") then
                            _rerun(session, command.substring(":rerun ".length).trim())
                        elif command.starts_with(":edit ") then
                            _edit(session, command.substring(":edit ".length).trim())
                        elif command =~ ":cells" then
                            _write_lines(CELL_LISTING.summary(session.submissions, 20))
                        elif command.starts_with(":cells ") then
                            _write_lines(CELL_LISTING.cell(session.submissions, command.substring(":cells ".length).trim()))
                        elif command.starts_with(":complete ") then
                            _complete(session, command.substring(":complete ".length))
                        elif command.starts_with(":hover ") then
                            _hover(session, command.substring(":hover ".length))
                        else
                            Std.write_line("unknown command {command}; :help for the list")
                        fi
                    esac

                    continue
                fi

                if read.step == CellStep.NOTHING then
                    continue
                fi

                let number = session.next_cell_number

                _report(session.submit(read.source), read.step == CellStep.SUBMIT, number, read.source)
            od

            session.close()
            _editor?.close()

            return 0
        si

        // An earlier cell's text, to be the cell edited at the next prompt.
        _pending_edit: string?

        _edit(session: HOSTED_SESSION, argument: string) is
            let number mut = 0

            if !int.try_parse(argument, number ref) then
                Std.write_line("usage: :edit N")

                return
            fi

            for cell in session.submissions do
                if cell.number == number then
                    if _editor? then
                        _pending_edit = cell.source
                    else
                        Std.write_line(":edit needs a terminal")
                    fi

                    return
                fi
            od

            Std.write_line("no cell {number}")
        si

        // `:rerun N` submits cell N again; `:rerun N..` submits N and every
        // later cell that ran to the end, in order, stopping at the first
        // that does not.
        _rerun(session: HOSTED_SESSION, argument: string) is
            let is_from = argument.ends_with("..")
            let digits = if is_from then argument.substring(0, argument.length - 2).trim() else argument fi
            let number mut = 0

            if !int.try_parse(digits, number ref) then
                Std.write_line("usage: :rerun N, or :rerun N.. for N and every later cell")

                return
            fi

            let cells =
                if is_from then
                    REPLAY.from(session.submissions, number)
                else
                    session.submissions |> Ghul.Pipes.filter(c => c.number == number) |> Ghul.Pipes.collect_list()
                fi

            if cells.count == 0 then
                Std.write_line("no cell {number}")

                return
            fi

            for cell in cells do
                let new_number = session.next_cell_number

                _show_replayed(new_number, cell.source)

                let result = session.rerun(cell.number)

                if !result? then
                    return
                fi

                _report(result, true, new_number, cell.source)

                if is_from /\ (!result.is_accepted \/ result.was_interrupted \/ result.run_error?) then
                    Std.write_line("ghul: stopped at cell {new_number}, the rerun of cell {cell.number}; later cells were not rerun")

                    return
                fi
            od
        si

        // A rerun cell's text, written as though it had been typed at its
        // own prompt.
        _show_replayed(number: int, source: string) is
            let prompt = "{number}> "
            let continuation = "{string(' ', prompt.length - 2)}| "
            let lines = source.trim_end(['\n']).split(['\n'])

            for i in 0..lines.count do
                Std.write_line("{if i == 0 then prompt else continuation fi}{lines[i]}")
            od
        si

        _write_lines(lines: Collections.Iterable[string]) is
            for line in lines do
                Std.write_line(line)
            od
        si

        // The next cell, or null when the input has ended.
        _read() -> CELL_READ? is
            if let editor = _editor then
                let text = _pending_edit
                _pending_edit = null

                return editor.read_cell(_current?.next_cell_number ?? 1, text)
            fi

            do
                let line = _reader.read_line(if _cell.is_empty then "> " else "| " fi)

                if !line? then
                    return null
                fi

                if _cell.is_empty /\ line.trim().starts_with(":") then
                    return CELL_READ(line, CellStep.SUBMIT, true)
                fi

                let step = _cell.enter(line)

                if step != CellStep.NOTHING /\ step != CellStep.WAIT then
                    let source = _cell.source

                    _cell.clear()

                    return CELL_READ(source, step, false)
                fi
            od
        si

        // For Ctrl-C, from the signal it raises: interrupts the cell running
        // now and says the signal is dealt with. At a terminal it is dealt
        // with regardless, since Ctrl-C does nothing when no cell runs;
        // for other input it ends the session.
        on_interrupt() -> bool is
            if let session = _current /\ session.interrupt() then
                return true
            fi

            if _editor? then
                return true
            fi

            close()

            return false
        si

        // For a signal that ends the process: closes the session in use
        // now, whatever the loop is doing.
        close() is
            _current?.close()
        si

        _report(result: SUBMIT_RESULT, want_value: bool, number: int, source: string) is
            for line in DIAGNOSTIC_VIEW.lines(result.diagnostics, "cell-{number}", source, if Std.is_error_redirected then null else _colours fi) do
                Std.error.write_line(line)
            od

            // After whatever the cell itself wrote, so a cell that
            // prints and then ends on a value reads in the order it ran.
            if want_value then
                if let shown = _display.format(result.value) then
                    Std.write_line(shown)
                fi
            fi

            if result.was_interrupted then
                Std.error.write_line("ghul: {SUBMIT_RESULT.INTERRUPTED_NOTE}")

                return
            fi

            if let error = result.run_error then
                Std.error.write_line(error)

                // It compiled, so what it declared is there for later
                // cells whatever its own code then did.
                Std.error.write_line("ghul: the cell was kept: it compiled, so its definitions are in the session")
            fi
        si

        // The names that could complete the one being typed at a line and
        // column of text, both from 1.
        _names(text: string, line: int, column: int) -> Collections.List[string]? is
            let lines = text.split(['\n'])
            let line_text = if line >= 1 /\ line <= lines.count then lines[line - 1] else "" fi
            let typed = COMPLETION_QUERY.prefix(line_text, column - 1)

            let offered = _current?.complete(text, line, column - typed.length)

            if !offered? then
                return null
            fi

            let names = LIST[string]()

            for item in offered do
                names.add(item.name)
            od

            return COMPLETION_QUERY.narrow(names, typed)
        si

        // What could follow some text, one name to a line.
        _complete(session: HOSTED_SESSION, text: string) is
            if let names = _names(text, 1, text.length + 1) then
                for name in names do
                    Std.write_line(name)
                od
            else
                Std.write_line("completion is not available")
            fi
        si

        // The declaration the last character of some text belongs to.
        _hover(session: HOSTED_SESSION, text: string) is
            if let shown = session.hover(text, 1, text.length) then
                Std.write_line(shown)
            elif session.is_analysis_available then
                Std.write_line("nothing there")
            else
                Std.write_line("hover is not available")
            fi
        si

        _write_help() is
            Std.write_line(":help            this list")
            Std.write_line(":reset           start a new session, forgetting every cell")
            Std.write_line(":cells           the cells so far: number, how each ended, its first line")
            Std.write_line(":cells N         the whole of cell N")
            Std.write_line(":rerun N         submit cell N again, as a new cell")
            Std.write_line(":rerun N..       submit cell N and every later cell that ran to the end,")
            Std.write_line("                 stopping if one of them does not this time")
            Std.write_line(":edit N          bring cell N back to edit as the next cell")
            Std.write_line(":complete TEXT   what could follow TEXT")
            Std.write_line(":hover TEXT      what the end of TEXT names")
            Std.write_line(":quit            leave")
            Std.write_line("")
            Std.write_line("a line that finishes an expression or a call submits what you have typed;")
            Std.write_line("a let, an assignment or a definition, or an if, case, loop or try over")
            Std.write_line("several lines, does not end the submission: keep typing, or end it with")
            Std.write_line("a blank line; a line that leaves something open waits for more")
            Std.write_line("a line holding only . ends the submission and shows what it ended on")
            Std.write_line("a submission is submitted from its last line; Enter on an earlier line adds")
            Std.write_line("a line, and Alt-Enter submits from any line, showing what it ended on")
            Std.write_line("a line ending in a lone \\ keeps the submission open; the \\ is dropped")
            Std.write_line("Up and Down move between lines, then to earlier submissions; Ctrl-D in an")
            Std.write_line("empty submission leaves")
            Std.write_line("Ctrl-Left and Ctrl-Right (or Alt-B and Alt-F) move by a word; Ctrl-U and")
            Std.write_line("Ctrl-K delete to the start or end of the line, Ctrl-W the word before the")
            Std.write_line("cursor; Ctrl-L clears the screen; Tab completes, listing the names on offer")
            Std.write_line("Ctrl-C while a submission runs interrupts it; the session carries on")
            Std.write_line("what you end on is shown, unless you end on a statement or with a blank line")
            Std.write_line("messages call a cell cell-3; in code it is cell3, as in cell3.x")

            if _want_default_use then
                Std.write_line("the compiler's default imports (use default) are in force in every cell")
            fi
        si
    si
si
