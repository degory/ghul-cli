namespace Ghul.Jupyter.Tests is
    use Collections.LIST
    use Ghul.Jupyter.CONNECTION
    use Ghul.Jupyter.JSON
    use Ghul.Jupyter.MESSAGE
    use IO.Std

    // Drives a kernel through what a notebook does. Takes the kernel
    // assembly to run, or an installed kernelspec to start it the way a
    // front end would, and a directory to work in; answers non-zero if
    // anything it checked did not hold.
    entry(args: string[]) -> int is
        if args.count < 2 then
            Std.error.write_line("usage: jupyter-client <kernel.dll | kernel.json> <directory> [--abandon]")

            return 1
        fi

        // Leaves the kernel to notice for itself that its front end has
        // gone, which is what happens to a user when the front end
        // crashes.
        let want_abandon = args.count > 2 /\ args[2] =~ "--abandon"

        let kernel_assembly = args[0]
        let directory = args[1]

        IO.Directory.create_directory(directory)

        let ports = _free_ports(5)
        let connection_file = IO.Path.join([directory, "connection.json"])

        IO.File.write_all_text(connection_file, _connection_json(ports))

        let connection = CONNECTION.read(connection_file)

        let start_info =
            if kernel_assembly.ends_with(".json") then
                _from_kernelspec(kernel_assembly, connection_file)
            else
                _from_assembly(kernel_assembly, connection_file)
            fi

        let started = System.Diagnostics.Process.start(start_info)

        if !started? then
            Std.error.write_line("could not start the kernel")

            return 1
        fi

        let process = started

        // The script owns this pid as well: a client killed before its
        // own cleanup runs - a timeout, a signal - must not leave a
        // kernel behind.
        IO.File.write_all_text(IO.Path.join([directory, "kernel.pid"]), "{process.id}")

        let client = CLIENT(connection)

        try
            if want_abandon then
                return _abandon(client)
            fi

            let outcome = _drive(client)

            // A kernel told to shut down has to go on its own, and take
            // its compile server with it.
            if !_waited_for_exit(process, 10) then
                Std.error.write_line("the kernel was still running after shutdown_request")

                return 1
            fi

            return outcome
        finally
            client.close()

            // Not in the abandoning run: leaving it is the point there,
            // and the script is what makes sure it went.
            if !want_abandon /\ !process.has_exited then
                process.kill(true)
            fi

            NetMQ.NetMQConfig.cleanup(false)
        yrt
    si

    // The front end goes without a word: this program checks the kernel
    // is up, then leaves it running and exits. What the kernel sees is
    // the process that started it disappearing, which is what a crashed
    // front end looks like - and which of them noticed is the script's
    // to check, since this program is the thing that has to go first.
    _from_assembly(kernel_assembly: string, connection_file: string) -> System.Diagnostics.ProcessStartInfo is
        let start_info = System.Diagnostics.ProcessStartInfo()

        start_info.file_name = "dotnet"
        start_info.use_shell_execute = false
        start_info.argument_list.add(kernel_assembly)
        start_info.argument_list.add("kernel")
        start_info.argument_list.add(connection_file)

        return start_info
    si

    // Starts the kernel from its kernelspec the way a front end launched
    // from a desktop does: with none of the shell's environment beyond
    // HOME, and the kernelspec's own `env` laid over that, `${{VAR}}`
    // expanded against it.
    _from_kernelspec(spec: string, connection_file: string) -> System.Diagnostics.ProcessStartInfo is
        let root = System.Text.Json.JsonDocument.parse(IO.File.read_all_text(spec), _).root_element
        let argv = LIST[string]()

        for part in root.get_property("argv").enumerate_array() do
            argv.add((part.get_string() ?? "").replace("{{connection_file}}", connection_file))
        od

        let start_info = System.Diagnostics.ProcessStartInfo()

        start_info.file_name = argv[0]
        start_info.use_shell_execute = false

        for i in 1..argv.count do
            start_info.argument_list.add(argv[i])
        od

        let home = start_info.environment["HOME"]

        start_info.environment.clear()
        start_info.environment["HOME"] = home

        for member in root.enumerate_object() do
            if member.name =~ "env" then
                for variable in member.value.enumerate_object() do
                    start_info.environment[variable.name] = _expand(variable.value.get_string() ?? "", start_info.environment)
                od
            fi
        od

        return start_info
    si

    _expand(value: string, environment: Collections.MutableMap[string, string?]) -> string is
        let result = System.Text.StringBuilder()
        let i mut = 0

        while i < value.length do
            let close = if value[i] == '$' /\ i + 1 < value.length /\ value[i + 1] == '{' then value.index_of('}', i) else -1 fi

            if close > 0 then
                let name = value.substring(i + 2, close - i - 2)

                if environment.contains_key(name) then
                    result.append(environment[name] ?? "")
                fi

                i = close + 1
            else
                result.append(value[i])
                i = i + 1
            fi
        od

        return result.to_string()
    si

    _abandon(client: CLIENT) -> int is
        Std.write_line("abandoning the kernel:")

        if !client.wait_until_subscribed()? then
            Std.error.write_line("the kernel never answered, so there is nothing to abandon")

            return 1
        fi

        Std.write_line("  the kernel is up; leaving it without a front end")

        return 0
    si

    _waited_for_exit(process: System.Diagnostics.Process, seconds: int) -> bool is
        let deadline = System.DateTime.utc_now.add_seconds(cast double(seconds))

        while System.DateTime.utc_now < deadline do
            if process.has_exited then
                return true
            fi

            System.Threading.Thread.sleep(200)
        od

        return process.has_exited
    si

    _drive(client: CLIENT) -> int is
        Std.write_line("kernel_info:")

        // Asks until the subscription is live, which is also what proves
        // the kernel brackets a request with status messages: without
        // them this never returns.
        let info = client.wait_until_subscribed()

        client.check(info?, "the kernel answers kernel_info_request and publishes its status")

        if let reply = info then
            client.check(reply.msg_type =~ "kernel_info_reply", "the answer is a kernel_info_reply")
            client.check(
                JSON.string_member(reply.content, "protocol_version") =~ "5.3",
                "it speaks protocol 5.3")
        fi

        Std.write_line("three chained cells:")

        _execute(client, "let x = 41\n", null)
        _execute(client, "add(n: int) -> int => n + 1\n", null)
        _execute(client, "add(x)\n", "42")

        Std.write_line("a cell ending on a sequence of tuples:")

        let table = _execute_raw(client, "[(1, \"one\"), (2, \"two\")]\n")

        client.check(
            _result_text(table.published) =~ "[(1, \"one\"), (2, \"two\")]",
            "its execute_result carries the line the terminal shows as text/plain")

        client.check(
            _result_html(table.published).contains("<th>`0</th><th>`1</th>"),
            "and a table beside it as text/html")

        Std.write_line("a cell that does not compile:")

        let broken = _execute_raw(client, "let y: int = \"not an int\"\n")

        client.check(
            _has(broken.published, "error"),
            "a cell that does not compile publishes an error")

        client.check(
            JSON.string_member(broken.reply_content, "status") =~ "error",
            "and its execute_reply says error")

        Std.write_line("the session survives it:")

        _execute(client, "add(x)\n", "42")

        Std.write_line("a cell that throws:")

        let threw = _execute_raw(client, "throw System.Exception(\"boom\")\n")

        client.check(_has(threw.published, "error"), "a cell that throws publishes an error")

        Std.write_line("a cell that writes:")

        let wrote = _execute_raw(client, "IO.Std.write_line(\"printed\")\nIO.Std.write(\"and \")\nIO.Std.write_line(123)\n")

        client.check(
            _stream_text(wrote.published) =~ "printed\nand 123\n",
            "what a cell writes arrives as a stream message, line endings included")

        Std.write_line("completion and inspection of an earlier cell's name:")

        _execute(client, "declared_in_an_earlier_cell(n: int) -> int => n * 2\n", null)

        let typed = "declared_in_an_ear"

        let completed = _complete(client, typed, typed.length)

        client.check(
            _names(completed) |> Ghul.Pipes.any(n => n =~ "declared_in_an_earlier_cell"),
            "completion offers a name declared in an earlier cell")

        client.check(
            _int_member(completed, "cursor_start") == 0 /\
                _int_member(completed, "cursor_end") == typed.length,
            "and replaces what has been typed of it")

        let inspected = _inspect(client, "declared_in_an_earlier_cell(1)", 3)

        client.check(
            inspected.contains("declared_in_an_earlier_cell") /\
                JSON.bool_member(inspected, "found", false),
            "inspection finds that name's declaration")

        Std.write_line("a cell that has to be interrupted:")

        _interrupt_case(client)

        Std.write_line("the session survives being interrupted:")

        _execute(client, "add(x)\n", "42")

        Std.write_line("is_complete:")

        _is_complete(client, "let x = 1\n", "complete")
        _is_complete(client, "if true then\n", "incomplete")

        Std.write_line("shutdown:")

        let sent_shutdown = client.send("shutdown_request", "{{\"restart\": false}}")

        let shutdown = client.reply()

        client.check(shutdown? /\ shutdown.msg_type =~ "shutdown_reply", "the kernel answers shutdown_request")

        if client.failures.count > 0 then
            Std.error.write_line("{client.failures.count} checks failed")

            return 1
        fi

        Std.write_line("all checks passed")

        return 0
    si

    // What one execute_request produced.
    class EXECUTION(published: Collections.List[MESSAGE], reply_content: string);

    _execute(client: CLIENT, code: string, want_value: string?) is
        let done = _execute_raw(client, code)

        client.check(
            JSON.string_member(done.reply_content, "status") =~ "ok",
            "the cell {code.trim()} ran")

        if let wanted = want_value then
            client.check(
                _result_text(done.published) =~ wanted,
                "the cell {code.trim()} produced {wanted}")
        fi
    si

    _execute_raw(client: CLIENT, code: string) -> EXECUTION is
        let content = JSON.object(
            LIST[(name: string, value: string)]([
                (name = "code", value = JSON.quote(code)),
                (name = "silent", value = "false"),
                (name = "store_history", value = "true"),
                (name = "allow_stdin", value = "false"),
                (name = "stop_on_error", value = "false")
            ]))

        let sent = client.send("execute_request", content)

        let published = client.published_until_idle(sent)
        let reply = client.reply()

        return EXECUTION(published, if let answer = reply then answer.content else JSON.EMPTY_OBJECT fi)
    si

    // A cell that will not stop on its own, stopped from the control
    // channel while the shell channel is inside it. The interrupt is
    // repeated because one that arrives while the cell is still
    // compiling finds nothing running and is answered without stopping
    // anything.
    _interrupt_case(client: CLIENT) is
        let content = JSON.object(
            LIST[(name: string, value: string)]([
                (name = "code", value = JSON.quote("while true do\nod\n")),
                (name = "silent", value = "false"),
                (name = "store_history", value = "true"),
                (name = "allow_stdin", value = "false"),
                (name = "stop_on_error", value = "false")
            ]))

        let _ = client.send("execute_request", content)

        let deadline = System.DateTime.utc_now.add_seconds(90.0)
        let reply: MESSAGE? mut = null

        while System.DateTime.utc_now < deadline /\ !reply? do
            let _ = client.send_control("interrupt_request", JSON.EMPTY_OBJECT)

            let _ = client.control_reply_within(System.TimeSpan.from_seconds(2.0))

            reply = client.reply_within(System.TimeSpan.from_seconds(2.0))
        od

        if !reply? then
            client.check(false, "an endless cell is stopped by interrupt_request")

            return
        fi

        client.check(true, "an endless cell is stopped by interrupt_request")

        client.check(
            JSON.string_member(reply.content, "status") =~ "error" /\
                JSON.string_member(reply.content, "ename") =~ "KeyboardInterrupt",
            "and its execute_reply says KeyboardInterrupt")
    si

    _is_complete(client: CLIENT, code: string, want: string) is
        let sent = client.send(
            "is_complete_request",
            JSON.object(LIST[(name: string, value: string)]([(name = "code", value = JSON.quote(code))])))

        let reply = client.reply()

        client.check(
            reply? /\ JSON.string_member(reply.content, "status") =~ want,
            "{code.trim()} is {want}")
    si

    _complete(client: CLIENT, code: string, cursor_pos: int) -> string is
        let sent =
            client.send(
                "complete_request",
                JSON.object(
                    LIST[(name: string, value: string)]([
                        (name = "code", value = JSON.quote(code)),
                        (name = "cursor_pos", value = "{cursor_pos}")
                    ])))

        let reply = client.reply()

        return if let answer = reply then answer.content else JSON.EMPTY_OBJECT fi
    si

    _inspect(client: CLIENT, code: string, cursor_pos: int) -> string is
        let sent =
            client.send(
                "inspect_request",
                JSON.object(
                    LIST[(name: string, value: string)]([
                        (name = "code", value = JSON.quote(code)),
                        (name = "cursor_pos", value = "{cursor_pos}"),
                        (name = "detail_level", value = "0")
                    ])))

        let reply = client.reply()

        return if let answer = reply then answer.content else JSON.EMPTY_OBJECT fi
    si

    // The names a complete_reply offered, read out of its matches array.
    _names(content: string) -> Collections.List[string] is
        let names = LIST[string]()

        try
            let document = System.Text.Json.JsonDocument.parse(content, _)
            let matches: System.Text.Json.JsonElement mut

            if document.root_element.try_get_property("matches", matches ref) then
                for match in matches.enumerate_array() do
                    if let name = match.get_string() then
                        names.add(name)
                    fi
                od
            fi
        catch e: System.Text.Json.JsonException
            return names
        yrt

        return names
    si

    _int_member(content: string, name: string) -> int is
        try
            let document = System.Text.Json.JsonDocument.parse(content, _)
            let value: System.Text.Json.JsonElement mut

            if document.root_element.try_get_property(name, value ref) then
                return value.get_int32()
            fi
        catch e: System.Text.Json.JsonException
            return -1
        yrt

        return -1
    si

    _has(published: Collections.List[MESSAGE], msg_type: string) -> bool is
        for message in published do
            if message.msg_type =~ msg_type then
                return true
            fi
        od

        return false
    si

    _result_text(published: Collections.List[MESSAGE]) -> string is
        for message in published do
            if message.msg_type =~ "execute_result" then
                return _plain_text(message.content)
            fi
        od

        return ""
    si

    _result_html(published: Collections.List[MESSAGE]) -> string is
        for message in published do
            if message.msg_type =~ "execute_result" then
                let document = System.Text.Json.JsonDocument.parse(message.content, _)
                let data: System.Text.Json.JsonElement mut
                let html: System.Text.Json.JsonElement mut

                if document.root_element.try_get_property("data", data ref) /\
                    data.try_get_property("text/html", html ref)
                then
                    return html.get_string() ?? ""
                fi
            fi
        od

        return ""
    si

    _plain_text(content: string) -> string is
        let document = System.Text.Json.JsonDocument.parse(content, _)
        let data: System.Text.Json.JsonElement mut
        let text: System.Text.Json.JsonElement mut

        if document.root_element.try_get_property("data", data ref) /\
            data.try_get_property("text/plain", text ref)
        then
            return text.get_string() ?? ""
        fi

        return ""
    si

    _stream_text(published: Collections.List[MESSAGE]) -> string is
        let parts = LIST[string]()

        for message in published do
            if message.msg_type =~ "stream" then
                parts.add(JSON.string_member(message.content, "text") ?? "")
            fi
        od

        return parts |> Ghul.Pipes.join("")
    si

    // Ports nothing else holds: bound, read back, and released, which is
    // what Jupyter itself does to fill in a connection file.
    _free_ports(count: int) -> Collections.List[int] is
        let listeners = LIST[System.Net.Sockets.TcpListener]()
        let ports = LIST[int]()

        for i in 0..count do
            let listener = System.Net.Sockets.TcpListener(System.Net.IPAddress.loopback, 0)

            listener.start()

            ports.add(cast System.Net.IPEndPoint(listener.local_endpoint).port)

            listeners.add(listener)
        od

        for listener in listeners do
            listener.stop()
        od

        return ports
    si

    _connection_json(ports: Collections.List[int]) -> string is
        let members = LIST[(name: string, value: string)]()

        members.add((name = "transport", value = JSON.quote("tcp")))
        members.add((name = "ip", value = JSON.quote("127.0.0.1")))
        members.add((name = "shell_port", value = "{ports[0]}"))
        members.add((name = "iopub_port", value = "{ports[1]}"))
        members.add((name = "stdin_port", value = "{ports[2]}"))
        members.add((name = "control_port", value = "{ports[3]}"))
        members.add((name = "hb_port", value = "{ports[4]}"))
        members.add((name = "key", value = JSON.quote("{System.Guid.new_guid()}")))
        members.add((name = "signature_scheme", value = JSON.quote("hmac-sha256")))
        members.add((name = "kernel_name", value = JSON.quote("ghul")))

        return JSON.object(members)
    si
si
