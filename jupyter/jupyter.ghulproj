<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GhulCompiler>dotnet ghul-compiler</GhulCompiler>

    <PackageId>ghul.jupyter</PackageId>
    <AssemblyName>ghul.jupyter</AssemblyName>
    <IsTool>true</IsTool>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ghul-jupyter</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetMQ" />

    <ProjectReference Include="../repl/repl.ghulproj" />
    <ProjectReference Include="../host/host.ghulproj" />

    <GhulSources Include="src/**/*.ghul" />
  </ItemGroup>
</Project>
