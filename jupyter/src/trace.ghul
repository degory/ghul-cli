namespace Ghul.Jupyter is
    // Every message crossing the wire, one line each on stderr, where
    // Jupyter shows it in the kernel log. Off unless GHUL_JUPYTER_TRACE
    // is set: without it, whether a front end ever sent a request can
    // only be inferred from what the kernel did next, which says
    // nothing at all about the requests it sends for nobody.
    class TRACE is
        _is_enabled: bool static

        // The kernel swaps IO.Std.error for a writer that publishes what
        // a running cell writes, so tracing through it would trace the
        // publication of its own trace line and never stop. This is the
        // real stderr, taken once and kept - and synchronized, because
        // shell and control both trace and a writer holds one buffer.
        //
        // It is a file stream on descriptor 2 rather than the console's
        // standard error stream: on Unix a write to a console stream
        // takes a lock on Console.Out, which a cell writing a line holds
        // while that line is published and traced, so a trace line from
        // the control thread in the meantime waits for the cell and the
        // cell waits for it.
        _stderr: IO.TextWriter static

        init() static is
            _is_enabled = System.Environment.get_environment_variable("GHUL_JUPYTER_TRACE")?

            let stream: IO.Stream =
                if System.OperatingSystem.is_windows() then
                    IO.Std.open_standard_error()
                else
                    IO.FileStream(Microsoft.Win32.SafeHandles.SafeFileHandle(2w, false), IO.FileAccess.WRITE, 1)
                fi

            let writer = IO.StreamWriter(stream)

            writer.auto_flush = true

            _stderr = IO.TextWriter.synchronized(writer)
        si

        is_enabled: bool static => _is_enabled

        received(channel: string, msg_type: string) static is
            _write("recv", channel, msg_type)
        si

        sent(channel: string, msg_type: string) static is
            _write("send", channel, msg_type)
        si

        _write(direction: string, channel: string, msg_type: string) static is
            if !_is_enabled then
                return
            fi

            _stderr.write_line("ghul-jupyter: trace: {direction} {channel} {msg_type}")
        si
    si
si
