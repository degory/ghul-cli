namespace Ghul.Jupyter is
    use Collections.LIST

    // Colours for a traceback, as the escape codes every notebook front
    // end renders: the standard red for an error and yellow for a
    // warning. The cell's source is left in the front end's own colour.
    class ANSI_DIAGNOSTIC_COLOURS: Ghul.Repl.DiagnosticColours is
        init() is si

        severity(severity: string, text: string) -> string =>
            if severity =~ "error" then
                ERROR_TRACEBACK.red(text)
            elif severity =~ "warn" then
                "\u001B[33m{text}\u001B[39m"
            else
                text
            fi

        code(line: string) -> string => line
    si

    class ERROR_TRACEBACK is
        init() is si

        red(text: string) -> string static => "\u001B[31m{text}\u001B[39m"

        // The exception's type and message, out of the first line of a
        // run-time error: `System.ArgumentException: message` names
        // ArgumentException, as a notebook shows an error's name. A line
        // that is not in that shape is all message.
        name_and_message(error: string) -> (name: string, message: string) static is
            let first = error.replace("\r\n", "\n").split(['\n'])[0]
            let colon = first.index_of(": ", System.StringComparison.ORDINAL)

            if colon <= 0 \/ first.substring(0, colon).contains(' ') then
                return (name = "Exception", message = first)
            fi

            let type = first.substring(0, colon)
            let dot = type.last_index_of('.')

            return (name = type.substring(dot + 1), message = first.substring(colon + 2))
        si

        // A run-time error as a traceback: the exception and its message
        // first, in red, and the frames after it as they are.
        of_exception(error: string) -> LIST[string] static is
            let lines = LIST[string](error.replace("\r\n", "\n").split(['\n']))

            if lines.count > 0 then
                lines[0] = red(lines[0])
            fi

            return lines
        si
    si
si
